  /* ── 连线绘制 ── */
  function orthPath(sx, sy, tx, ty, axis, r) {
    const dx = tx - sx, dy = ty - sy;
    if (axis === 'h') {
      if (Math.abs(dy) < 1) return ['M ' + sx + ' ' + sy + ' L ' + tx + ' ' + ty, (sx + tx) / 2, ty];
      const mx = (sx + tx) / 2, d = Math.sign(dy), rr = Math.min(r, Math.abs(dy) / 2, Math.abs(dx) / 2 || r);
      return ['M ' + sx + ' ' + sy + ' L ' + (mx - rr) + ' ' + sy + ' Q ' + mx + ' ' + sy + ' ' + mx + ' ' + (sy + d * rr)
        + ' L ' + mx + ' ' + (ty - d * rr) + ' Q ' + mx + ' ' + ty + ' ' + (mx + rr) + ' ' + ty + ' L ' + tx + ' ' + ty, mx, ty];
    }
    if (Math.abs(dx) < 1) return ['M ' + sx + ' ' + sy + ' L ' + tx + ' ' + ty, tx, (sy + ty) / 2];
    const my = (sy + ty) / 2, d = Math.sign(dx), rr = Math.min(r, Math.abs(dx) / 2, Math.abs(dy) / 2 || r);
    return ['M ' + sx + ' ' + sy + ' L ' + sx + ' ' + (my - rr) + ' Q ' + sx + ' ' + my + ' ' + (sx + d * rr) + ' ' + my
      + ' L ' + (tx - d * rr) + ' ' + my + ' Q ' + tx + ' ' + my + ' ' + tx + ' ' + (my + rr) + ' L ' + tx + ' ' + ty, tx, my];
  }

  function drawEdges() {
    const canvas = $('arch-canvas'), svg = $('arch-svg'), labels = $('arch-labels');
    if (!canvas || !svg || !labels) return;
    if (!canvas.offsetWidth) return;
    const cr = canvas.getBoundingClientRect();
    svg.setAttribute('width', cr.width);
    svg.setAttribute('height', cr.height);
    /* 只清掉上一轮画的线/点，保留 <defs> 里的箭头 marker */
    svg.querySelectorAll('path[data-from], circle[data-from]').forEach((el) => el.remove());
    labels.innerHTML = '';
    const NS = 'http://www.w3.org/2000/svg';
    const link = {};

    EDGES.forEach((e) => {
      const A = canvas.querySelector('.arch-node[data-node-id="' + e.from + '"]');
      const B = canvas.querySelector('.arch-node[data-node-id="' + e.to + '"]');
      if (!A || !B) return;
      const ar = A.getBoundingClientRect(), br = B.getBoundingClientRect();
      let sx, sy, tx, ty;
      if (e.route === 'h') {
        const y1 = e.y1 == null ? .5 : e.y1, y2 = e.y2 == null ? .5 : e.y2;
        sx = ar.right - cr.left; sy = ar.top - cr.top + ar.height * y1;
        tx = br.left - cr.left;  ty = br.top - cr.top + br.height * y2;
      } else {
        const x1 = e.x1 == null ? .5 : e.x1, x2 = e.x2 == null ? .5 : e.x2;
        sx = ar.left - cr.left + ar.width * x1; sy = ar.bottom - cr.top;
        tx = br.left - cr.left + br.width * x2;  ty = br.top - cr.top;
      }
      const [d, lx, ly] = orthPath(sx, sy, tx, ty, e.route, 8);

      const dot = document.createElementNS(NS, 'circle');
      dot.setAttribute('cx', sx); dot.setAttribute('cy', sy); dot.setAttribute('r', 2.6);
      dot.dataset.from = e.from; dot.dataset.to = e.to;
      svg.appendChild(dot);

      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', d);
      p.setAttribute('class', 'k-' + (e.kind || 'write'));
      p.setAttribute('marker-end', 'url(#ah-' + (e.kind || 'write') + ')');
      p.dataset.from = e.from; p.dataset.to = e.to;
      svg.appendChild(p);

      const lab = document.createElement('span');
      lab.className = 'elabel';
      lab.textContent = e.label;
      lab.style.left = lx + 'px';
      lab.style.top = ly + 'px';
      lab.dataset.kind = e.kind || 'write';
      lab.dataset.from = e.from; lab.dataset.to = e.to;
      labels.appendChild(lab);
      link[e.from + '>' + e.to] = { p, dot, lab, kind: e.kind || 'write' };
    });

    canvas.querySelectorAll('.arch-node').forEach((n) => {
      if (n.dataset.bound) return;
      n.dataset.bound = '1';
      n.addEventListener('click', () => {
        selectedNode = (selectedNode === n.dataset.nodeId) ? null : n.dataset.nodeId;
        syncSelection();
      });
    });
    canvas.__links = link;
    syncSelection();   /* 重画后必须重新上色，否则旧的选中态会丢（2026-10-09 实锤） */
  }

  function syncSelection() {
    const canvas = $('arch-canvas'), detail = $('arch-detail');
    if (!canvas) return;
    const sel = selectedNode;
    const neigh = {};
    if (sel) EDGES.forEach((e) => { if (e.from === sel) neigh[e.to] = 1; if (e.to === sel) neigh[e.from] = 1; });

    canvas.querySelectorAll('.arch-node').forEach((n) => {
      const id = n.dataset.nodeId;
      n.classList.toggle('is-selected', id === sel);
      n.classList.toggle('is-linked', !!(sel && neigh[id]));
      n.classList.toggle('is-dim', !!(sel && id !== sel && !neigh[id]));
      n.setAttribute('aria-pressed', id === sel ? 'true' : 'false');
    });
    const links = canvas.__links || {};
    Object.keys(links).forEach((k) => {
      const hit = !!sel && (k.split('>')[0] === sel || k.split('>')[1] === sel);
      const l = links[k];
      l.p.classList.toggle('is-active', hit);
      l.p.classList.toggle('is-dim', !!sel && !hit);
      l.p.setAttribute('marker-end', hit ? 'url(#ah-on)' : 'url(#ah-' + (l.kind || 'write') + ')');
      l.dot.classList.toggle('is-active', hit);
      l.dot.classList.toggle('is-dim', !!sel && !hit);
      l.lab.classList.toggle('is-active', hit);
      l.lab.classList.toggle('is-dim', !!sel && !hit);
    });

    if (!sel || !NODE_DETAIL[sel]) {
      detail.classList.remove('has');
      detail.innerHTML = '<span class="muted" style="font-size:12px">点上面的任意组件，这里会显示它的项目、启动方式、关键文件和实时状态。</span>';
      return;
    }
    const spec = NODE_DETAIL[sel];
    const node = LAYERS.flatMap((l) => l.nodes).find((n) => n.id === sel) || { name: sel, tech: '' };
    const facts = liveFacts(sel, currentData || {});
    detail.classList.add('has');
    detail.innerHTML = '<div class="dh"><span class="ic" style="width:26px;height:26px;border-radius:8px;background:var(--surface-3);display:grid;place-items:center;color:var(--text-2)">' + icon(node.icon) + '</span>'
      + '<span class="nm">' + esc(node.name) + '</span>'
      + '<span class="tag ondemand">' + esc(node.tech) + '</span></div>'
      + '<div class="kv">'
      + '<span class="k">用了什么</span><span class="v">' + esc(spec.project) + '</span>'
      + '<span class="k">怎么起</span><span class="v">' + esc(spec.run) + '</span>'
      + '<span class="k">关键文件</span><span class="v">' + spec.files.map((x) => '<code class="p">' + esc(x) + '</code>').join(' ') + '</span>'
      + (spec.env.length ? '<span class="k">环境变量</span><span class="v">' + spec.env.map((x) => '<code class="p">' + esc(x) + '</code>').join(' ') + '</span>' : '')
      + '<span class="k">说明</span><span class="v">' + esc(spec.note) + '</span>'
      + (facts.length ? '<span class="k">实时</span><span class="v">' + facts.map((f) => esc(f[0]) + '：' + esc(f[1])).join(' ｜ ') + '</span>' : '')
      + '</div>';
  }

  /* ============================================================
     5. 刷新 / 标签页 / 登录
     ============================================================ */
  let currentPassword = '', lastBlobHash = '', pollTimer = null, currentData = null;

  function renderAll(data) {
    currentData = data;
    renderTasks(data);
    renderArch(data);
    const el = $('meta-update');
    if (el) el.textContent = data.generatedAt ? fmtDT(data.generatedAt) : '—';
  }

  async function refresh() {
    if (!currentPassword) return;
    try {
      const blob = await fetchBlob();
      const h = await blobHash(blob);
      if (h === lastBlobHash) return;
      lastBlobHash = h;
      renderAll(await decryptBlob(blob, currentPassword));
      try { updateChannelIndicator(); } catch (e) {}
    } catch (e) {
      console.error('refresh failed:', e);
      if (/OperationError|decrypt/i.test(String(e))) { sessionStorage.removeItem('dashboard-pw'); location.reload(); }
    }
  }

  function switchTab(name) {
    document.querySelectorAll('#seg button').forEach((b) => b.classList.toggle('on', b.dataset.tab === name));
    $('panel-tasks').style.display = name === 'tasks' ? '' : 'none';
    $('panel-arch').style.display = name === 'arch' ? '' : 'none';
    if (name === 'arch') requestAnimationFrame(() => { drawEdges(); syncSelection(); });
  }

  async function doLogin() {
    const pw = $('pw').value;
    if (!pw) return;
    const errEl = $('error'), btn = $('btn');
    btn.disabled = true;
    errEl.textContent = '解密中…（PBKDF2 20 万轮，约 1–2 秒）';
    await new Promise((r) => setTimeout(r, 10));
    try {
      const blob = await fetchBlob();
      const data = await decryptBlob(blob, pw);
      currentPassword = pw;
      sessionStorage.setItem('dashboard-pw', pw);
      lastBlobHash = await blobHash(blob);
      $('login').style.display = 'none';
      $('app').style.display = 'block';
      renderAll(data);
      try { updateChannelIndicator(); } catch (e) {}
      errEl.textContent = '';
      if (pollTimer) clearInterval(pollTimer);
      pollTimer = setInterval(refresh, POLL_MS);
    } catch (e) {
      errEl.textContent = '密码不正确';
    } finally {
      btn.disabled = false;
    }
  }

  $('btn').addEventListener('click', doLogin);
  $('pw').addEventListener('keydown', (e) => { if (e.key === 'Enter') doLogin(); });
  document.querySelectorAll('#seg button').forEach((b) => b.addEventListener('click', () => switchTab(b.dataset.tab)));
  window.addEventListener('resize', () => { if ($('panel-arch').style.display !== 'none') drawEdges(); });
  if (window.ResizeObserver) new ResizeObserver(() => { if ($('panel-arch').style.display !== 'none') drawEdges(); }).observe(document.body);
  window.addEventListener('beforeunload', () => { if (pollTimer) clearInterval(pollTimer); });

  (function boot() {
    const saved = sessionStorage.getItem('dashboard-pw');
    if (saved) { $('pw').value = saved; doLogin(); }
  })();
  </script>
</body>
</html>
