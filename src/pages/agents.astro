  function liveFacts(id, data) {
    const arch = data.architecture || {};
    const health = data.health || {};
    const f = [];
    const svcOf = (label) => (health.services || []).find((s) => s.label === label);
    if (id === 'gateway') {
      const s = svcOf('ai.openclaw.gateway');
      f.push(['运行状态', s && s.pid && s.pid !== '-' ? '运行中 · pid ' + s.pid : '未运行']);
      f.push(['通道', (arch.channels || []).map((c) => c.name).join(' · ') || '—']);
      f.push(['插件', (arch.plugins || []).filter((p) => p.enabled).map((p) => p.id).join(' · ') || '—']);
      f.push(['agents', (arch.agents || []).map((a) => a.id).join(' · ') || '—']);
    }
    if (id === 'codex') {
      const s = svcOf('ai.feishu-codex-bridge.bot');
      f.push(['桥接进程', s && s.pid && s.pid !== '-' ? '运行中 · pid ' + s.pid : '未运行']);
      const tk = (data.resources || {}).codexTodayTokens || {};
      f.push(['今日 token', tk.total ? num(tk.total) + '（出 ' + num(tk.output) + '）' : '—']);
      f.push(['今日会话', String((data.resources || {}).codexSessionsToday || 0)]);
    }
    if (id === 'xiaomi') {
      const skills = (arch.skills || []).filter((s) => s.eligible && !s.disabled);
      f.push(['可用技能', skills.length + ' 个（其中 ' + skills.filter((s) => s.modelVisible).length + ' 个模型直接可见）']);
      f.push(['自装技能', (arch.skills || []).filter((s) => s.ours).map((s) => s.name).join(' · ') || '—']);
    }
    if (id === 'bus') {
      const runs = data.tasks || [];
      f.push(['任务记录', runs.length + ' 条，最新 ' + (runs.length ? runs[runs.length - 1].run_id : '—')]);
      f.push(['委派记录', ((data.resources || {}).recentDelegations || []).length + ' 次（今日）']);
    }
    if (id === 'snapshot') {
      f.push(['最近生成', fmtDT(data.generatedAt)]);
      const s = svcOf('ai.agent-dashboard.push');
      f.push(['推送任务', s ? (s.pid && s.pid !== '-' ? '运行中' : '已安装 · 非持续运行') : '未安装']);
    }
    if (id === 'site') f.push(['线上入口', 'frankofswing.com/agents/']);
    return f;
  }

