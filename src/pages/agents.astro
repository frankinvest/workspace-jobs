---
// src/pages/agents.astro —— Agent 控制台（密码门 + 浏览器端解密）
//
// 两个视图：① 任务进度（谁在干活 / 到哪一步 / 花了多少） ② 架构地图（用了什么项目 / 怎么连 / 怎么起）
//
// 关键实现说明（改之前先读）：
//  1) <style is:global> 必须是 global —— 页面内容几乎全是运行期用 JS 渲染的，
//     Astro 默认会给 <style> 加 [data-astro-cid-*] 作用域，而 JS 创建的节点没有那个属性，
//     导致所有样式静默失效（v2 页面"难看"的真正原因）。
//  2) 静态 HTML 里**不得出现**任何基建明文（模型名、run_id、密码、密钥、字段名 costUsd）。
//     检查见 ~/.openclaw/agent-dashboard/check_dashboard.py 的 C8/C9。
//  3) 数据是密文，浏览器解密后渲染；无人打开页面 = 不发任何请求；打开时每 10 秒刷新。
---
<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Agent 控制台</title>
  <style is:global>
    /* ===== 设计令牌 ===== */
    *, *::before, *::after { box-sizing: border-box; }
    :root {
      --bg:#f6f7f9; --surface:#ffffff; --surface-2:#fbfcfd; --surface-3:#f2f4f7;
      --border:#e4e7ec; --border-2:#d0d5dd;
      --text:#0f1728; --text-2:#475467; --text-3:#98a2b3;
      --accent:#4f46e5; --accent-2:#4338ca; --accent-soft:#eef2ff; --accent-line:#c7d2fe;
      --ok:#12b76a; --ok-soft:#ecfdf3; --ok-line:#a6f4c5;
      --run:#f79009; --run-soft:#fffaeb; --run-line:#fedf89;
      --fail:#f04438; --fail-soft:#fef3f2; --fail-line:#fecdca;
      --idle-soft:#f2f4f7;
      --r:12px; --r-sm:8px;
      --shadow:0 1px 2px rgba(16,24,40,.05);
      
      --mono:ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      /* plan §1: V1 字号阶梯 (6 组合) + V2 8px 间距 */
      --fs-hero:22px; --fs-title:17px; --fs-secondary:14px;
      --fs-body:13.5px; --fs-meta:12px; --fs-label:11px;
      --fw-regular:400; --fw-medium:500; --fw-semibold:600;
      --space-1:4px; --space-2:8px; --space-3:12px; --space-4:16px; --space-5:24px;

    }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin:0; background:var(--bg); color:var(--text);
      font:14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", system-ui, sans-serif;
      -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
    }
    .wrap { max-width:1240px; margin:0 auto; padding:24px; }
    .mono { font-family:var(--mono); }
    .num { font-variant-numeric:tabular-nums; font-feature-settings:"tnum"; }

    /* ===== 登录 ===== */
    #login { max-width:380px; margin:14vh auto 0; }
    .login-card { background:var(--surface); border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 3px rgba(16,24,40,.08); padding:26px; }
    .brand { display:flex; align-items:center; gap:10px; margin-bottom:18px; }
    .brand-mark { width:30px; height:30px; border-radius:9px; background:var(--accent); color:#fff; display:grid; place-items:center; flex:none; }
    .brand-name { font-size:17px; font-weight:600; letter-spacing:-.01em; }
    #login h1 { margin:0 0 4px; font-size:14px; font-weight:500; color:var(--text-2); }
    #login .hint { color:var(--text-3); font-size:12px; margin:0 0 18px; line-height:1.6; }
    #login label { display:block; font-size:12px; font-weight:500; color:var(--text-2); margin-bottom:6px; }
    #pw { width:100%; padding:10px 12px; font:inherit; background:#fff; color:var(--text); border:1px solid var(--border-2); border-radius:var(--r-sm); outline:none; transition:border-color .15s, box-shadow .15s; }
    #pw:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
    #btn { width:100%; margin-top:10px; padding:11px; background:var(--accent); color:#fff; border:0; border-radius:var(--r-sm); font:inherit; font-weight:600; cursor:pointer; transition:background .15s; }
    #btn:hover { background:var(--accent-2); }
    #btn:disabled { background:var(--border-2); cursor:not-allowed; }
    #error { color:var(--fail); margin-top:10px; min-height:18px; font-size:12px; }

    /* ===== 顶栏 ===== */
    #app { display:none; }
    .topbar { display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-bottom:18px; }
    .topbar .brand-name { font-size:17px; }
    .topbar .spacer { flex:1; }
    .live { display:inline-flex; align-items:center; gap:7px; font-size:12px; color:var(--text-2); background:var(--surface); border:1px solid var(--border); border-radius:999px; padding:5px 12px; }
    .live i { width:7px; height:7px; border-radius:50%; background:var(--text-3); box-shadow:0 0 0 3px var(--surface); }
    .live.is-local i { background:var(--ok); box-shadow:0 0 0 3px var(--ok-soft); }
    /* edge-data: 边缘代理生效（手机/非 Mac 的常态）—— 与"本地绿"区分，但仍是"新鲜"语义 */
    .live.is-edge i { background:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
    .stamp { font-size:12px; color:var(--text-3); font-family:var(--mono); }

    /* ===== 分段控件 ===== */
    .seg { display:inline-flex; background:#ebedf1; border-radius:10px; padding:3px; gap:2px; margin-bottom:18px; }
    .seg button { border:0; background:none; font:inherit; font-size:13.5px; font-weight:500; color:var(--text-2); padding:7px 17px; border-radius:8px; cursor:pointer; transition:background .15s,color .15s; }
    .seg button:hover { color:var(--text); }
    .seg button.on { background:#fff; color:var(--text); box-shadow:var(--shadow); }

    /* ===== 卡片 ===== */
    .card { background:var(--surface); border:1px solid var(--border); border-radius:var(--r); box-shadow:var(--shadow); padding:16px; }
    .card + .card { margin-top:12px; }
    .sec { font-size:11px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--text-3); margin:0 0 12px; }
    .cols { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(0,1fr); gap:14px; align-items:start; }
    .cols-3 { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; align-items:start; }
    .stack { display:flex; flex-direction:column; gap:14px; }
    .stack > .card { margin-top:0; flex:1; }
    .muted { color:var(--text-3); }
    .empty { color:var(--text-3); font-size:13.5px; padding:10px 0; }

    /* ===== 胶囊 / 徽章 ===== */
    .pill { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; padding:4px 10px; border-radius:999px; white-space:nowrap; }
    .pill i { width:6px; height:6px; border-radius:50%; background:currentColor; flex:none; }
    .pill.run { color:#b54708; background:var(--run-soft); }
    .pill.ok { color:#027a48; background:var(--ok-soft); }
    .pill.fail { color:#b42318; background:var(--fail-soft); }
    .pill.idle { color:var(--text-2); background:var(--idle-soft); }
    .tag { display:inline-block; font-size:11px; font-weight:600; padding:2px 7px; border-radius:6px; white-space:nowrap; }
    .tag.default { color:var(--accent-2); background:var(--accent-soft); }
    .tag.ondemand { color:var(--text-2); background:var(--surface-3); }
    .tag.alert { color:#b54708; background:var(--run-soft); }
    .tag.codex { color:var(--accent-2); background:var(--accent-soft); }
    .tag.xiaomi { color:#b54708; background:#fef0c7; }

    /* ===== 任务进度：Hero ===== */
    .hero { display:flex; gap:22px; align-items:center; justify-content:space-between; flex-wrap:wrap; }
    .hero-main { min-width:280px; flex:1; }
    .hero h2 { margin:10px 0 6px; font-size:20px; font-weight:600; letter-spacing:-.015em; line-height:1.4; }
    .hero .sub { color:var(--text-3); font-size:12px; font-family:var(--mono); }
    .owner { display:flex; align-items:center; gap:14px; padding:14px 18px; border:1px solid var(--border); border-radius:var(--r); background:var(--surface-2); min-width:300px; }
    .owner[data-state="running"] { border-color:var(--run-line); background:var(--run-soft); }
    .owner[data-state="done"] { border-color:var(--ok-line); background:var(--ok-soft); }
    .avatar { width:42px; height:42px; border-radius:50%; display:grid; place-items:center; font-size:14px; font-weight:600; flex:none; background:#fff; border:1px solid var(--border); }
    .avatar[data-who="codex"] { color:var(--accent-2); background:var(--accent-soft); border-color:var(--accent-line); }
    .avatar[data-who="xiaomi"] { color:#b54708; background:#fef0c7; border-color:var(--run-line); }
    .owner .lbl { font-size:11px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--text-3); }
    .owner .nm { font-size:17px; font-weight:600; letter-spacing:-.01em; margin-top:1px; }
    .owner .rl { font-size:12px; color:var(--text-2); margin-top:1px; }
    .owner .eta { margin-left:auto; text-align:right; }
    .owner .eta .v { font-size:14px; font-weight:600; font-family:var(--mono); font-variant-numeric:tabular-nums; }
    .owner .eta .k { font-size:11px; color:var(--text-3); }

    /* ===== 任务进度：阶段轨 ===== */
    .rail { position:relative; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); margin:22px 0 4px; }
    .rail-line, .rail-fill { position:absolute; top:11px; height:2px; border-radius:2px; }
    .rail-line { left:12.5%; right:12.5%; background:var(--border); }
    .rail-fill { left:12.5%; background:var(--accent); transition:width .4s ease; }
    .rail-step { position:relative; display:flex; flex-direction:column; align-items:center; text-align:center; gap:7px; padding:0 4px; }
    .rail-dot { width:24px; height:24px; border-radius:50%; background:#fff; border:1.5px solid var(--border-2); color:var(--text-3); display:grid; place-items:center; }
    .rail-step.done .rail-dot { background:var(--accent); border-color:var(--accent); color:#fff; }
    .rail-step.current .rail-dot { border-color:var(--accent); border-width:2px; background:var(--accent-soft); color:var(--accent-2); font-weight:600; box-shadow:0 0 0 4px var(--accent-soft); animation:breathe 2.2s ease-in-out infinite; }
    @keyframes breathe { 0%,100% { box-shadow:0 0 0 4px var(--accent-soft); } 50% { box-shadow:0 0 0 7px rgba(79,70,229,.10); } }
    .rail-step .sn { font-size:13.5px; font-weight:500; color:var(--text-3); }
    .rail-step.done .sn, .rail-step.current .sn { color:var(--text); font-weight:600; }
    .rail-step.current .sn { color:var(--accent-2); font-weight:600; }
    .rail-step.current .sm { color:var(--accent-2); font-weight:600; }
    .rail-step .sm { font-size:11px; color:var(--text-3); font-family:var(--mono); }

    /* ===== 活动流 ===== */
    .feed { display:flex; flex-direction:column; }
    .feed-row { display:flex; align-items:center; gap:10px; min-height:44px; padding:8px 0; border-top:1px solid var(--surface-3); }
    .feed-row:first-child { border-top:0; }
    .feed-row.new { background:var(--accent-soft); border:1px solid var(--accent); border-radius:8px; padding:8px 10px; }
    .feed-t { font-family:var(--mono); font-size:11px; color:var(--text-3); flex:none; width:64px; text-align:right; }
    .feed-w { flex:none; }
    .feed-a { font-size:13.5px; color:var(--text); }
    .feed-f { font-family:var(--mono); font-size:11px; color:var(--text-3); margin-left:auto; flex:none; }

    /* ===== 统计块 ===== */
    .stats { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    .stat { background:var(--surface-2); border:1px solid var(--border); border-radius:10px; padding:11px 12px; }
    .stat .k { font-size:11px; color:var(--text-3); }
    .stat .v { font-size:20px; font-weight:600; letter-spacing:-.02em; margin-top:3px; font-variant-numeric:tabular-nums; }
    .stat .v small { font-size:12px; font-weight:400; color:var(--text-3); margin-left:3px; letter-spacing:0; }
    .bars { margin-top:14px; display:flex; flex-direction:column; gap:8px; }
    .bar { display:grid; grid-template-columns:minmax(70px,1fr) 2fr auto; gap:9px; align-items:center; font-size:12px; }
    .bar .bl { color:var(--text-2); font-family:var(--mono); font-size:11px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .bar .bt { height:6px; border-radius:3px; background:var(--surface-3); overflow:hidden; }
    .bar .bf { height:100%; background:var(--accent); border-radius:3px; }
    .bar .bv { font-family:var(--mono); font-size:11px; color:var(--text-2); font-variant-numeric:tabular-nums; }
    .pv-h { font-size:12px; font-weight:600; color:var(--text); margin:0 0 8px; display:flex; align-items:center; gap:8px; }
    .pv-s { font-size:11px; color:var(--text-3); margin-top:6px; line-height:1.5; }

    /* ===== 健康 ===== */
    .svc { display:flex; align-items:center; gap:9px; padding:6px 0; font-size:12px; }
    .svc .dot { width:8px; height:8px; border-radius:50%; flex:none; }
    .svc .dot.up { background:var(--ok); box-shadow:0 0 0 3px var(--ok-soft); }
    .svc .dot.down { background:var(--fail); box-shadow:0 0 0 3px var(--fail-soft); }
    .svc .lb { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .svc .pd { font-family:var(--mono); font-size:11px; color:var(--text-3); }
    .wd { margin-top:10px; border-top:1px solid var(--surface-3); padding-top:8px; }
    .wd-row { font-family:var(--mono); font-size:11px; color:var(--text-2); padding:3px 0; }
    .wd-row .tt { color:var(--text-3); }

    /* ===== 表格 ===== */
    table.tbl { width:100%; border-collapse:collapse; table-layout:fixed; font-size:13.5px; font-weight:400; }
    table.tbl th { text-align:left; font-size:11px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--text-3); padding:0 12px 8px 0; border-bottom:1px solid var(--border); }
    table.tbl th.right, table.tbl td.right { text-align:right; }
    table.tbl td { padding:0 12px 0 0; border-bottom:1px solid var(--surface-3); vertical-align:middle; height:44px; font-size:13.5px; font-weight:400; }
    table.tbl tr:last-child td { border-bottom:0; }
    table.tbl td.n { font-family:var(--mono); font-size:12px; color:var(--text-2); white-space:nowrap; font-variant-numeric:tabular-nums; }
    table.tbl th.col-elapsed, table.tbl td.col-elapsed { text-align:right; }
    table.tbl td.dim { color:var(--text-3); }
    table.tbl col.c-task { width:46%; } table.tbl col.c-verdict { width:11%; } table.tbl col.c-owner { width:10%; } table.tbl col.c-attempts { width:8%; } table.tbl col.c-elapsed { width:12%; } table.tbl col.c-stages { width:13%; }
    table.tbl .col-task .task-title { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    table.tbl .col-task .run-id-line { font-size:11px; }
    .history-card .history-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; }
    .history-card .history-expand-btn { background:var(--surface-2); color:var(--text-2); border:1px solid var(--border); padding:4px 10px; border-radius:4px; cursor:pointer; font-size:11px; }
    .history-card .history-expand-btn:hover { background:var(--surface-3); }
    .history-card.is-collapsed .history-row:nth-child(n+9) { display:none; }

    /* ===== 架构地图 ===== */
    .arch-head { display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:14px; }
    .arch-legend { display:flex; flex-wrap:wrap; gap:6px 17px; }
    .lg { display:inline-flex; align-items:center; gap:6px; font-size:12px; color:var(--text-2); }
    .lg i { width:8px; height:8px; border-radius:3px; flex:none; }
    .arch-hint { font-size:12px; color:var(--text-3); }
    .flowlegend { display:flex; flex-wrap:wrap; gap:6px 14px; margin:0 0 14px; padding:9px 12px; background:var(--surface-2); border:1px solid var(--border); border-radius:10px; }
    .flowlegend span { display:inline-flex; align-items:center; gap:6px; font-size:12px; color:var(--text-2); }
    .flowlegend i { width:14px; height:2.5px; border-radius:2px; flex:none; }
    .arch-canvas { position:relative; padding:2px 0; }
    .arch-layers { display:flex; flex-direction:column; gap:12px; }
    .arch-layer { background:var(--surface-2); border:1px solid var(--border); border-radius:var(--r); padding:12px; display:grid; grid-template-columns:112px minmax(0,1fr); gap:14px; }
    .arch-layer-head { display:flex; align-items:flex-start; gap:7px; padding-top:5px; }
    .arch-layer-head i { width:8px; height:8px; border-radius:3px; margin-top:4px; flex:none; }
    .arch-layer-head .n { font-size:12px; font-weight:600; color:var(--text-2); line-height:1.35; }
    .arch-layer-head .c { font-size:11px; color:var(--text-3); }
    .arch-nodes { display:flex; gap:12px; flex-wrap:wrap; align-items:stretch; }
    .arch-node { position:relative; z-index:3; flex:1 1 210px; max-width:340px; min-height:96px; text-align:left; font:inherit; cursor:pointer; background:#fff; border:1px solid var(--border); border-radius:10px; padding:12px; transition:border-color .15s, box-shadow .15s, opacity .15s; }
    .arch-node:hover { border-color:var(--accent-line); }
    .arch-node:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
    .arch-node .top { display:flex; align-items:center; gap:8px; }
    .arch-node .ic { width:26px; height:26px; border-radius:8px; background:var(--surface-3); color:var(--text-2); display:grid; place-items:center; flex:none; }
    .arch-node .nm { font-size:13.5px; font-weight:600; letter-spacing:-.005em; }
    .arch-node .tech { font-family:var(--mono); font-size:11px; color:var(--accent-2); margin-top:7px; line-height:1.45; }
    .arch-node .role { font-size:12px; color:var(--text-2); margin-top:3px; line-height:1.45; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .arch-node.is-hub { border-color:var(--accent-line); background:var(--accent-soft); }
    .arch-node.is-hub .ic { background:var(--accent-soft); color:var(--accent-2); }
    .arch-node.is-selected { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
    .arch-node.is-linked { border-color:var(--accent-line); }
    .arch-node.is-dim { opacity:.32; }
    .arch-edges { position:absolute; inset:0; width:100%; height:100%; z-index:2; pointer-events:none; overflow:visible; }
    .arch-edges path { fill:none; stroke:#94a3b8; stroke-width:2.2; transition:stroke .15s, opacity .15s, stroke-width .15s; }
    .arch-edges path.k-msg { stroke:#f79009; }
    .arch-edges path.k-call { stroke:#4f46e5; }
    .arch-edges path.k-handoff { stroke:#7c3aed; }
    .arch-edges path.k-write { stroke:#64748b; }
    .arch-edges path.k-deliver { stroke:#0ea5e9; }
    .arch-edges path.is-active { stroke:var(--accent); stroke-width:3.2; }
    .arch-edges path.is-dim { opacity:.15; }
    .arch-edges circle { fill:#fff; stroke:#94a3b8; stroke-width:2; transition:stroke .15s, opacity .15s; }
    .arch-edges circle.is-active { stroke:var(--accent); }
    .arch-edges circle.is-dim { opacity:.15; }
    #arch-labels { position:absolute; inset:0; z-index:4; pointer-events:none; }
    .elabel { position:absolute; transform:translate(-50%,-50%); display:inline-flex; align-items:center; gap:5px; background:#fff; border:1px solid var(--border-2); border-radius:999px; padding:2.5px 9px; font-family:var(--mono); font-size:11px; color:var(--text-2); white-space:nowrap; transition:all .15s; }
    .elabel::before { content:''; width:6px; height:6px; border-radius:50%; background:#94a3b8; flex:none; }
    .elabel[data-kind="msg"]::before { background:#f79009; }
    .elabel[data-kind="call"]::before { background:#4f46e5; }
    .elabel[data-kind="handoff"]::before { background:#7c3aed; }
    .elabel[data-kind="write"]::before { background:#64748b; }
    .elabel[data-kind="deliver"]::before { background:#0ea5e9; }
    .elabel.is-active { border-color:var(--accent); color:var(--accent-2); background:var(--accent-soft); }
    .elabel.is-dim { opacity:.22; }
    .arch-detail { margin-top:14px; border:1px dashed var(--border-2); border-radius:var(--r); background:var(--surface-2); padding:14px 17px; }
    .arch-detail.has { border-style:solid; background:var(--surface); }
    .arch-detail .dh { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .arch-detail .dh .nm { font-size:14px; font-weight:600; }
    .kv { display:grid; grid-template-columns:86px minmax(0,1fr); gap:4px 12px; margin-top:10px; font-size:12px; }
    .kv .k { color:var(--text-3); }
    .kv .v { color:var(--text-2); word-break:break-word; }
    .kv .v code, code.p { font-family:var(--mono); font-size:12px; background:var(--surface-3); border-radius:4px; padding:1px 5px; color:var(--text-2); }
    .list { list-style:none; margin:0; padding:0; font-size:12px; }
    .list li { display:flex; gap:9px; justify-content:space-between; align-items:baseline; padding:6px 0; border-top:1px solid var(--surface-3); }
    .list li:first-child { border-top:0; }
    .list li .n { font-family:var(--mono); font-size:12px; color:var(--text-2); word-break:break-all; }
    .list li .d { color:var(--text-3); font-size:12px; text-align:right; flex:none; max-width:46%; }
    .patch { border:1px solid var(--border); border-left:3px solid var(--run); border-radius:8px; padding:10px 12px; margin-bottom:8px; background:var(--surface-2); }
    .patch .pp { font-size:12px; color:var(--text); line-height:1.5; }
    .patch .pf { font-family:var(--mono); font-size:11px; color:var(--accent-2); margin-top:5px; word-break:break-all; }
    .patch .pe { font-family:var(--mono); font-size:11px; color:#9a3412; margin-top:2px; word-break:break-all; }
    .patch .pn { font-size:12px; color:var(--text-3); margin-top:4px; }

    /* ===== 移动端 ===== */
    @media (max-width: 980px) {
      .wrap { padding:17px; }
      .cols, .cols-3 { grid-template-columns:minmax(0,1fr); }
      .arch-layer { grid-template-columns:minmax(0,1fr); gap:8px; }
      .arch-layer-head { padding-top:0; }
      .arch-nodes { flex-direction:column; }
      .arch-node { max-width:none; }
      .arch-edges, #arch-labels { display:none; }
      .hero { gap:14px; }
      .owner { min-width:0; width:100%; }
      .hero h2 { font-size:17px; }
      .rail-step .sm { font-size:10px; }
      .rail-step .sn { font-size:12px; }
      table.tbl { font-size:12px; }
      table.tbl td.hide-s, table.tbl th.hide-s { display:none; }
    }

  /* === task-panel-v2: 阶段可展开 === */
  .stages-card .stages { display:flex; flex-direction:column; gap:8px; margin-top:8px; }
  .stage-item { background: var(--surface-2, #14171c); border: 1px solid var(--border, #1f2329); border-radius: 8px; overflow: hidden; }
  .stage-item.is-current { border-color: var(--accent, #2a6df4); box-shadow: 0 0 0 1px var(--accent, #2a6df4); }
  .stage-item.todo { opacity: 0.6; }
  .stage-header { display: grid; grid-template-columns: 24px 90px 1fr auto 24px; align-items: center; gap: 10px; padding: 10px 14px; cursor: pointer; user-select: none; }
  .stage-header:hover { background: rgba(255,255,255,0.02); }
  .stage-header:focus { outline: 1px solid var(--accent, #2a6df4); outline-offset: -1px; }
  .stage-marker { width:28px; height:28px; border-radius:50%; background:var(--surface-2); color:var(--text-3); font-size:11px; font-weight:600; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; }
  .stage-item.done .stage-marker { background:var(--ok-soft); color:var(--ok-line); }
  .stage-item.current .stage-marker { background:var(--accent); color:#fff; box-shadow:0 0 0 4px var(--accent-soft); }
  .stage-item.is-current .stage-marker { animation: stage-pulse 2s ease-in-out infinite; }
  @keyframes stage-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(42,109,244,0.5); } 50% { box-shadow: 0 0 0 6px rgba(42,109,244,0); } }
  .stage-name { font-weight:600; color:#fff; font-size:17px; }
  .stage-who { color:var(--text-2); font-size:12px; font-family:var(--mono); }
  .stage-time { color:var(--text-3); font-size:11px; font-weight:600; font-family:var(--mono); }
  .stage-toggle { color: #888; font-size: 12px; text-align: center; }
  .stage-body { padding: 0 14px 12px 48px; display: none; }
  .stage-item[aria-expanded="true"] > .stage-body { display: block; }
  .stage-empty { color: #666; font-style: italic; font-size: 12px; padding: 6px 0; }
  .stage-file { padding: 6px 0; border-top: 1px dashed var(--border, #1f2329); }
  .stage-file:first-child { border-top: 0; }
  .stage-file-head { display: flex; gap: 8px; align-items: baseline; margin-bottom: 4px; }
  .file-name { font-family: ui-monospace, monospace; font-size: 12px; color: #4a8df4; }
  .file-title { font-size: 12px; color: #888; }
  .file-excerpt { color: #c0c0c0; font-size: 12px; line-height: 1.5; background: rgba(0,0,0,0.2); padding: 6px 8px; border-radius: 4px; font-style: italic; word-break: break-word; }
  .stage-verdict { margin: 8px 0; }
  .stage-file-excerpt { color: #c0c0c0; font-size: 12px; line-height: 1.5; padding: 6px 8px; }
  .hist-progress { display: inline-flex; gap: 3px; align-items: center; }
  .hist-progress .hdot { width: 8px; height: 8px; border-radius: 50%; background: #1a1d22; display: inline-block; }
  .hist-progress .hdot.on { background: #4f4; }
  .hist-progress .hdot.cur { background: #4a8df4; }
  .run-id-display { font-family: ui-monospace, monospace; color: #4a8df4; }
  .history-card .empty { color: #666; font-style: italic; padding: 12px; text-align: center; font-size: 12px; }
  </style>
</head>
<body>
  <div id="login" class="wrap">
    <div class="login-card">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">
