---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Icon from '../components/icons/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SearchBox from '../components/SearchBox.astro';
import PortfolioSidebar from '../components/PortfolioSidebar.astro';
import { normalizeBody, BODY_EXCERPT_LENGTH } from '../utils/search';
import type { Article } from '../utils/search';
import stockHoldings from '../../data/stock_holdings.json';

// Get all docs and sort by date
const allDocs = await getCollection('docs');

// 用 import.meta.glob 扫描 docs/ 目录下的 .html 原生文件（build time，SSR 安全）
const htmlGlob = import.meta.glob<string>('/docs/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

// 构建与 allDocs 结构兼容的 HTML 条目
const htmlEntries = Object.keys(htmlGlob).map(rawPath => {
  const fname = rawPath.split('/').pop() || '';
  const dateStr = fname.match(/(\d{8})/)?.[1] || '';
  const y = dateStr.slice(0, 4), m = dateStr.slice(4, 6), d = dateStr.slice(6, 8);
  return {
    id: fname,
    data: { title: '财经早餐 ' + (y && m && d ? `${y}-${m}-${d}` : dateStr) },
    body: '',
    collection: 'docs',
    isRawHtml: true,
  };
});

const sortedDocs = [...allDocs, ...htmlEntries].sort((a, b) => {
  const dateA = a.id.match(/(\d{8})/)?.[1] || '';
  const dateB = b.id.match(/(\d{8})/)?.[1] || '';
  return dateB.localeCompare(dateA);
});

// Format date helper
const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  const year = dateStr.slice(0, 4);
  const month = dateStr.slice(4, 6);
  const day = dateStr.slice(6, 8);
  return `${year}年${parseInt(month)}月${parseInt(day)}日`;
};

// Get greeting based on time
const hour = new Date().getHours();
const greetingMap = {
  morning: { text: '早安', icon: 'sun' },
  noon: { text: '午安', icon: 'sun' },
  afternoon: { text: '下午好', icon: 'sun' },
  evening: { text: '晚上好', icon: 'moon' },
};
const greeting = hour < 12 ? greetingMap.morning : hour < 14 ? greetingMap.noon : hour < 18 ? greetingMap.afternoon : greetingMap.evening;

// Today formatted
const today = new Date().toLocaleDateString('zh-CN', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric', 
  weekday: 'long' 
});

// 构建时间戳（用于验证部署状态）
const buildTime = new Date().toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', hour12: false });

// Build search index for SearchBox (injected client-side as JSON)
const searchIndex: Article[] = sortedDocs.map((doc) => {
  const dateMatch = doc.id.match(/(\d{8})/);
  const date = dateMatch ? dateMatch[1] : '';
  const rawBody = ('body' in doc && (doc as any).body) ? (doc as any).body : '';
  const body = normalizeBody(rawBody).slice(0, BODY_EXCERPT_LENGTH);
  return {
    slug: doc.id.replace(/\.md$/, '').replace(/\.html$/, ''),
    title: doc.data.title || doc.id,
    date,
    body,
  };
});

// Process articles
const articles = sortedDocs.map((doc, idx) => {
  const dateMatch = doc.id.match(/(\d{8})/);
  const date = dateMatch ? dateMatch[1] : '';
  
  let tag = '其他';
  let tagColor = 'var(--color-bg-elevated)';
  let tagTextColor = 'var(--color-text-muted)';
  
  if (doc.id.includes('财经早餐分析') || doc.id.includes('年报') || doc.id.includes('原文') || doc.id.endsWith('.html')) {
    tag = '财经早餐';
    tagColor = 'var(--color-accent-dim)';
    tagTextColor = 'var(--color-accent)';
  } else if (doc.id.includes('奏折')) {
    tag = '尚书省奏折';
    tagColor = 'var(--color-danger-dim)';
    tagTextColor = 'var(--color-danger)';
  } else if (doc.id.includes('问题总结')) {
    tag = '工作流文档';
    tagColor = 'var(--color-success-dim)';
    tagTextColor = 'var(--color-success)';
  }
  
  // Extract title from filename — clean up JJC 前缀和冗余数字
  let title = doc.data.title || '';
  if (!title) {
    // 去掉 .md 后缀
    let raw = doc.id.replace(/\.md$/, '');
    // 去掉 JJC-YYYYMMDD-NNN- 前缀（通用模式）
    raw = raw.replace(/^jjc-\d{8}-\d+[-_]*/i, '');
    // 再次去掉任何残留的日期+数字前缀（如 20260330-001-）
    raw = raw.replace(/^\d{8}-\d+[-_]*/, '');
    // 把剩余的横杠替换成空格
    title = raw.replace(/-/g, ' ').trim();
    // 如果标题仍然只是纯数字或太短，使用原文件 ID
    if (!title || /^\d+$/.test(title)) {
      title = doc.id.replace('.md', '').replace(/-/g, ' ');
    }
  }
  
  return {
    id: doc.id,
    title,
    date,
    formattedDate: formatDate(date),
    tag,
    tagColor,
    tagTextColor,
    index: idx,
  };
});

// Group articles by tag (only show 财经早餐)
const groupedArticles = {
  '财经早餐': articles.filter(a => a.tag === '财经早餐'),
};

// 文章数量统计（仅用于信息展示）
const articleCount = groupedArticles['财经早餐'].length;

// P0-2 今日速览 TL;DR（Frank 决策#2：内容只能从当天财经早餐文章 frontmatter 抽取，无外源）
const todayDate = new Date();
const todayStr = `${todayDate.getFullYear()}${String(todayDate.getMonth() + 1).padStart(2, '0')}${String(todayDate.getDate()).padStart(2, '0')}`;
const todayDoc = allDocs.find((doc) => {
  const m = doc.id.match(/JJC-(\d{8})/i);
  return m && m[1] === todayStr;
});
const tldrCategoryOrder = ['macro', 'policy', 'anomaly', 'stock', 'fx'] as const;
const tldrCategoryLabels: Record<string, string> = {
  macro: '宏观',
  policy: '政策',
  anomaly: '异动',
  stock: '个股',
  fx: '外汇',
};
const tldrItems = (todayDoc?.data as any)?.tldr
  ? tldrCategoryOrder
      .map((cat) => (todayDoc.data as any).tldr.find((t: any) => t.category === cat))
      .filter((t) => t !== undefined)
  : [];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="财经早餐 - 每日财经资讯、宏观新闻、股票分析" />
    <title>财经早餐</title>
    
    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet">
    
    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect fill='%230a0505' width='100' height='100' rx='20'/><path d='M25 70 L25 45 L40 45 L40 70 M45 70 L45 35 L60 35 L60 70 M65 70 L65 50 L80 50 L80 70' stroke='%23e60000' stroke-width='6' fill='none' stroke-linecap='round'/></svg>">
  </head>
  <body>
    <!-- Background decoration -->
    <div class="bg-decoration" aria-hidden="true">
      <div class="bg-gradient"></div>
      <div class="bg-grid"></div>
      <div class="bg-vignette"></div>
    </div>
    
    <main class="container">
      <!-- Header -->
      <header class="hero">
        <div class="hero-greeting">
          <span class="greeting-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {hour < 18
                ? '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>'
                : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>'
              }
            </svg>
          </span>
          <span>{greeting.text}</span>
        </div>
        
        <div class="hero-logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <rect width="48" height="48" rx="12" fill="var(--color-accent-dim)"/>
            <path d="M12 34V24M18 34V20M24 34V26M30 34V18M36 34V22" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        
        <h1 class="hero-title gradient-text">财经早餐</h1>
        
        <p class="hero-subtitle">宏观趋势 · 行业研究 · 投资思考</p>
        
        <time class="hero-date">
          <Icon name="calendar" size={14} />
          <span>{today}</span>
          <span class="hero-date-divider">·</span>
          <span>每日更新</span>
        </time>
        
        <!-- 文章数量 -->
        {articleCount > 0 && (
          <p class="hero-count">{articleCount} 篇财经早餐</p>
        )}

      </header>

      {/* P0-2 今日速览 TL;DR（只从当天文章 frontmatter tldr 字段抽取，无外源） */}
      {tldrItems.length > 0 && (
        <section class="tldr-section" aria-label="今日速览">
          <div class="tldr-header">
            <h2 class="tldr-title">今日速览</h2>
            <span class="tldr-subtitle">
              从 {todayStr.slice(0, 4)}-{todayStr.slice(4, 6)}-{todayStr.slice(6, 8)} 当天财经早餐提取
            </span>
          </div>
          <div class="tldr-grid">
            {tldrItems.map((item) => (
              <a href={item.articleLink} class={`tldr-card tldr-${item.category}`}>
                <span class={`tldr-bar tldr-bar-${item.category}`}></span>
                <div class="tldr-category">{tldrCategoryLabels[item.category] || item.category}</div>
                <div class="tldr-headline">{item.title}</div>
                {item.keyNumbers && item.keyNumbers.length > 0 && (
                  <div class="tldr-numbers">
                    {item.keyNumbers.map((n) => (
                      <span class="tldr-number">{n}</span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- 主内容区: 左 2/3 文章 + 右 1/3 Frank 持仓 sidebar (移动端堆叠) -->
      <div class="layout-grid">
        <div class="article-container">
          <SearchBox articles={searchIndex} />
          <div class="sections">
            {groupedArticles['财经早餐'].length > 0 && (
              <section class="section">
                <SectionHeader title="财经早餐" icon="chart" count={groupedArticles['财经早餐'].length} />
                <div class="article-list">
                  {groupedArticles['财经早餐'].map((article, idx) => (
                    <div class="article-card-slot" data-article-slot style={idx >= 3 ? 'display:none' : undefined}>
                      <ArticleCard {...article} />
                    </div>
                  ))}
                </div>
                <div class="article-more-wrap">
                  <button type="button" id="article-more-btn" class="article-more-btn">展开更多</button>
                  <button type="button" id="article-all-btn" class="article-more-btn">展开所有</button>
                </div>
              </section>
            )}
          </div>
        </div>
        <PortfolioSidebar holdings={stockHoldings as any} />
      </div>

      <!-- Footer -->
      <footer class="footer">
        <p>财经早餐 · 由 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> + <a href="https://vercel.com" target="_blank" rel="noopener">Vercel</a> 驱动</p>
        <p class="build-info">构建版本: {buildTime}</p>
      </footer>
    </main>

    <script>
      const ARTICLE_VISIBLE_INITIAL = 3;
      const ARTICLE_VISIBLE_STEP = 6;
      const articleSlots = Array.from(document.querySelectorAll('[data-article-slot]'));
      const articleMoreBtn = document.getElementById('article-more-btn');
      const articleAllBtn = document.getElementById('article-all-btn');
      let articleVisibleCount = ARTICLE_VISIBLE_INITIAL;

      function updateArticleVisibility() {
        articleSlots.forEach((slot, idx) => {
          slot.style.display = idx < articleVisibleCount ? '' : 'none';
        });
        const remaining = Math.max(articleSlots.length - articleVisibleCount, 0);
        if (articleMoreBtn) {
          articleMoreBtn.hidden = remaining <= 0;
          articleMoreBtn.textContent = remaining > 0 ? `展开更多（还剩 ${remaining} 篇）` : '已全部展示';
        }
        if (articleAllBtn) {
          articleAllBtn.hidden = remaining <= 0;
        }
      }

      articleMoreBtn?.addEventListener('click', () => {
        articleVisibleCount += ARTICLE_VISIBLE_STEP;
        updateArticleVisibility();
      });

      articleAllBtn?.addEventListener('click', () => {
        articleVisibleCount = articleSlots.length;
        updateArticleVisibility();
      });

      updateArticleVisibility();
    </script>
  </body>
</html>

<style>
  /* Background */
  .bg-decoration {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  
  .bg-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 70%;
    background: 
      radial-gradient(ellipse 100% 60% at 50% -20%, rgba(230, 0, 0, 0.15), transparent 60%),
      radial-gradient(ellipse 80% 40% at 20% -10%, rgba(200, 0, 0, 0.08), transparent 50%),
      radial-gradient(ellipse 60% 30% at 80% 0%, rgba(230, 0, 0, 0.1), transparent 50%),
      linear-gradient(180deg, rgba(10, 5, 5, 0.95) 0%, transparent 100%);
  }
  
  .bg-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(230, 0, 0, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(230, 0, 0, 0.05) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 20%, transparent 80%);
  }
  
  .bg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 100% 100% at 50% 50%, transparent 40%, rgba(15, 8, 8, 0.6) 100%);
  }
  
  /* Container */
  .container {
    position: relative;
    z-index: var(--z-base);
    max-width: 1200px;
  }
  
  /* Hero */
  .hero {
    text-align: center;
    padding-bottom: var(--space-16);
    margin-bottom: var(--space-12);
    position: relative;
  }
  
  .hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  }
  
  .hero-greeting {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
    animation: fadeInUp 0.5s ease-out;
  }

  .greeting-icon {
    display: flex;
  }

  .hero-logo {
    margin-bottom: var(--space-4);
    animation: fadeInUp 0.5s ease-out 0.1s both;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(36px, 8vw, var(--font-size-4xl));
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-3);
    animation: fadeInUp 0.5s ease-out 0.15s both;
  }

  .hero-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    letter-spacing: 0.2em;
    font-weight: var(--font-weight-light);
    margin-bottom: var(--space-4);
    animation: fadeInUp 0.5s ease-out 0.2s both;
  }

  .hero-date {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    animation: fadeInUp 0.5s ease-out 0.25s both;
  }

  .hero-date-divider {
    opacity: 0.5;
  }

  /* 文章数量 */
  .hero-count {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-3);
    animation: fadeInUp 0.5s ease-out 0.3s both;
    letter-spacing: 0.05em;
  }
  
  /* Sections */
  .sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  
  .section {
    animation: fadeInUp 0.5s ease-out 0.4s both;
  }
  
  .article-list {
    display: flex;
    flex-direction: column;
  }

  .article-more-wrap {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .article-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
  }

  .article-more-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-dim);
  }

  /* ── P0-2 今日速览 TL;DR ── */
  .tldr-section {
    max-width: 1200px;
    margin: 0 auto var(--space-8);
    padding: 0 var(--space-4);
  }

  .tldr-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .tldr-title {
    font-family: var(--font-serif);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.05em;
  }

  .tldr-subtitle {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .tldr-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-3);
  }

  .tldr-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    overflow: hidden;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .tldr-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .tldr-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
  }

  .tldr-bar-macro { background: #3b82f6; }
  .tldr-bar-policy { background: #a855f7; }
  .tldr-bar-anomaly { background: #ef4444; }
  .tldr-bar-stock { background: #22c55e; }
  .tldr-bar-fx { background: #f59e0b; }

  .tldr-category {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .tldr-macro .tldr-category { color: #3b82f6; }
  .tldr-policy .tldr-category { color: #a855f7; }
  .tldr-anomaly .tldr-category { color: #ef4444; }
  .tldr-stock .tldr-category { color: #22c55e; }
  .tldr-fx .tldr-category { color: #f59e0b; }

  .tldr-headline {
    font-size: var(--font-size-sm);
    line-height: 1.5;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tldr-numbers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tldr-number {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1024px) {
    .tldr-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .tldr-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Grid 布局: 左 2/3 文章 + 右 1/3 Frank 持仓 sidebar ── */
  .layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    align-items: start;
  }

  .article-container {
    min-width: 0; /* 防 grid item 内容溢出 */
  }

  /* 移动端: 单列堆叠 (sidebar 落到文章下方) */
  @media (max-width: 1024px) {
    .layout-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
  
  /* Footer */
  .footer {
    text-align: center;
    padding: var(--space-16) 0 var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }
  
  .footer a {
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }
  
  .footer a:hover {
