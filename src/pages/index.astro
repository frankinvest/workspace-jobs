---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Icon from '../components/icons/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionHeader from '../components/SectionHeader.astro';

// Get all docs and sort by date
const allDocs = await getCollection('docs');

// 用 import.meta.glob 扫描 docs/ 目录下的 .html 原生文件（build time，SSR 安全）
const htmlGlob = import.meta.glob<string>('/docs/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

// 构建与 allDocs 结构兼容的 HTML 条目
const htmlEntries = Object.keys(htmlGlob).map(rawPath => {
  const fname = rawPath.split('/').pop() || '';
  const dateStr = fname.match(/(\d{8})/)?.[1] || '';
  const y = dateStr.slice(0, 4), m = dateStr.slice(4, 6), d = dateStr.slice(6, 8);
  return {
    id: fname,
    data: { title: '财经早餐 ' + (y && m && d ? `${y}-${m}-${d}` : dateStr) },
    body: '',
    collection: 'docs',
    isRawHtml: true,
  };
});

const sortedDocs = [...allDocs, ...htmlEntries].sort((a, b) => {
  const dateA = a.id.match(/(\d{8})/)?.[1] || '';
  const dateB = b.id.match(/(\d{8})/)?.[1] || '';
  return dateB.localeCompare(dateA);
});

// Format date helper
const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  const year = dateStr.slice(0, 4);
  const month = dateStr.slice(4, 6);
  const day = dateStr.slice(6, 8);
  return `${year}年${parseInt(month)}月${parseInt(day)}日`;
};

// Get greeting based on time
const hour = new Date().getHours();
const greetingMap = {
  morning: { text: '早安', icon: 'sun' },
  noon: { text: '午安', icon: 'sun' },
  afternoon: { text: '下午好', icon: 'sun' },
  evening: { text: '晚上好', icon: 'moon' },
};
const greeting = hour < 12 ? greetingMap.morning : hour < 14 ? greetingMap.noon : hour < 18 ? greetingMap.afternoon : greetingMap.evening;

// Today formatted
const today = new Date().toLocaleDateString('zh-CN', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric', 
  weekday: 'long' 
});

// 构建时间戳（用于验证部署状态）
const buildTime = new Date().toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', hour12: false });

// Process articles
const articles = sortedDocs.map((doc, idx) => {
  const dateMatch = doc.id.match(/(\d{8})/);
  const date = dateMatch ? dateMatch[1] : '';
  
  let tag = '其他';
  let tagColor = 'var(--color-bg-elevated)';
  let tagTextColor = 'var(--color-text-muted)';
  
  if (doc.id.includes('财经早餐分析') || doc.id.includes('年报') || doc.id.includes('原文') || doc.id.endsWith('.html')) {
    tag = '财经早餐';
    tagColor = 'var(--color-accent-dim)';
    tagTextColor = 'var(--color-accent)';
  } else if (doc.id.includes('奏折')) {
    tag = '尚书省奏折';
    tagColor = 'var(--color-danger-dim)';
    tagTextColor = 'var(--color-danger)';
  } else if (doc.id.includes('问题总结')) {
    tag = '工作流文档';
    tagColor = 'var(--color-success-dim)';
    tagTextColor = 'var(--color-success)';
  }
  
  // Extract title from filename — clean up JJC 前缀和冗余数字
  let title = doc.data.title || '';
  if (!title) {
    // 去掉 .md 后缀
    let raw = doc.id.replace(/\.md$/, '');
    // 去掉 JJC-YYYYMMDD-NNN- 前缀（通用模式）
    raw = raw.replace(/^jjc-\d{8}-\d+[-_]*/i, '');
    // 再次去掉任何残留的日期+数字前缀（如 20260330-001-）
    raw = raw.replace(/^\d{8}-\d+[-_]*/, '');
    // 把剩余的横杠替换成空格
    title = raw.replace(/-/g, ' ').trim();
    // 如果标题仍然只是纯数字或太短，使用原文件 ID
    if (!title || /^\d+$/.test(title)) {
      title = doc.id.replace('.md', '').replace(/-/g, ' ');
    }
  }
  
  return {
    id: doc.id,
    title,
    date,
    formattedDate: formatDate(date),
    tag,
    tagColor,
    tagTextColor,
    index: idx,
  };
});

// Group articles by tag (only show 财经早餐)
const groupedArticles = {
  '财经早餐': articles.filter(a => a.tag === '财经早餐'),
};

// 文章数量统计（仅用于信息展示）
const articleCount = groupedArticles['财经早餐'].length;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="财经早餐 - 每日财经资讯、宏观新闻、股票分析" />
    <title>财经早餐</title>
    
    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet">
    
    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect fill='%230a0505' width='100' height='100' rx='20'/><path d='M25 70 L25 45 L40 45 L40 70 M45 70 L45 35 L60 35 L60 70 M65 70 L65 50 L80 50 L80 70' stroke='%23e60000' stroke-width='6' fill='none' stroke-linecap='round'/></svg>">
  </head>
  <body>
    <!-- Background decoration -->
    <div class="bg-decoration" aria-hidden="true">
      <div class="bg-gradient"></div>
      <div class="bg-grid"></div>
      <div class="bg-vignette"></div>
    </div>
    
    <main class="container">
      <!-- Header -->
      <header class="hero">
        <div class="hero-greeting">
          <span class="greeting-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {hour < 18
                ? '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>'
                : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>'
              }
            </svg>
          </span>
          <span>{greeting.text}</span>
        </div>
        
        <div class="hero-logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <rect width="48" height="48" rx="12" fill="var(--color-accent-dim)"/>
            <path d="M12 34V24M18 34V20M24 34V26M30 34V18M36 34V22" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        
        <h1 class="hero-title gradient-text">财经早餐</h1>
        
        <p class="hero-subtitle">宏观趋势 · 行业研究 · 投资思考</p>
        
        <time class="hero-date">
          <Icon name="calendar" size={14} />
          <span>{today}</span>
          <span class="hero-date-divider">·</span>
          <span>每日更新</span>
        </time>
        
        <!-- 文章数量 -->
        {articleCount > 0 && (
          <p class="hero-count">{articleCount} 篇财经早餐</p>
        )}
      </header>

      <!-- 主内容区：左目录 + 右查询 双栏布局 (feature/dividend-web-ui) -->
      <div class="main-split-layout">
        <!-- 左栏：财经早餐文章列表 (~70%) -->
        <div class="article-column">
          <div class="sections">
            {groupedArticles['财经早餐'].length > 0 && (
              <section class="section">
                <SectionHeader title="财经早餐" icon="chart" count={groupedArticles['财经早餐'].length} />
                <div class="article-list">
                  {groupedArticles['财经早餐'].map((article) => (
                    <ArticleCard {...article} />
                  ))}
                </div>
              </section>
            )}
          </div>
        </div>

        <!-- 右栏：红利狙击查询面板 (~30%, sticky) -->
        <aside class="dividend-column">
          <div class="dividend-column-header">
            <h2 class="dividend-column-title">🎯 红利狙击</h2>
            <p class="dividend-column-sub">前瞻股息率智能预测</p>
          </div>
          <section class="sniper-panel">
            <form id="sniper-form" autocomplete="off">
              <input
                id="sniper-code"
                class="sniper-input"
                type="text"
                name="code"
                placeholder="股票代码 / 简称"
                maxlength="20"
              />
              <button id="sniper-btn" class="sniper-btn" type="submit">
                狙击股息率
              </button>
              <div id="sniper-loading" class="sniper-loading">
                正在调度预测引擎...
              </div>
            </form>

            <div id="sniper-result" class="result-board" aria-live="polite">
              <div class="result-grid">
                <div class="result-cell full">
                  <div class="result-label">股票</div>
                  <div class="result-value" data-field="name">—</div>
                  <div class="result-meta">
                    <span data-field="code">—</span>
                    ·
                    <span data-field="industry">—</span>
                  </div>
                </div>
                <div class="result-cell">
                  <div class="result-label">现价 (元)</div>
                  <div class="result-value-row">
                    <span class="result-value" data-field="current_price">—</span>
                    <button
                      id="btn-update-price"
                      class="btn-refresh-price"
                      type="button"
                      title="闪电拦截盘中真价, 写入云端 KV"
                    >
                      <span class="btn-icon">🔄</span>
                      <span class="btn-label">更新现价</span>
                    </button>
                  </div>
                  <div class="result-meta" data-field="price_source">—</div>
                </div>
                <div class="result-cell">
                  <div class="result-label">前瞻 EPS (元)</div>
                  <div class="result-value" data-field="estimated_eps">—</div>
                </div>
                <div class="result-cell full">
                  <div class="result-label">前瞻股息率 TTM</div>
                  <div class="result-value accent" data-field="predicted_dividend_yield">—</div>
                  <div class="result-meta" data-field="qualitative_adjustment">—</div>
                </div>
              </div>
              <div id="sniper-error" class="result-error" style="display:none"></div>
            </div>
          </section>
          <p class="dividend-column-foot">
            ⚠️ Mock 模式 (feature/dividend-web-ui)，未对接 dividend_calculator.py
          </p>
        </aside>
      </div>

      <!-- Footer -->
      <footer class="footer">
        <p>财经早餐 · 由 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> + <a href="https://vercel.com" target="_blank" rel="noopener">Vercel</a> 驱动</p>
        <p class="build-info">构建版本: {buildTime}</p>
      </footer>
    </main>
  </body>
</html>

<style>
  /* Background */
  .bg-decoration {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  
  .bg-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 70%;
    background: 
      radial-gradient(ellipse 100% 60% at 50% -20%, rgba(230, 0, 0, 0.15), transparent 60%),
      radial-gradient(ellipse 80% 40% at 20% -10%, rgba(200, 0, 0, 0.08), transparent 50%),
      radial-gradient(ellipse 60% 30% at 80% 0%, rgba(230, 0, 0, 0.1), transparent 50%),
      linear-gradient(180deg, rgba(10, 5, 5, 0.95) 0%, transparent 100%);
  }
  
  .bg-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(230, 0, 0, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(230, 0, 0, 0.05) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 20%, transparent 80%);
  }
  
  .bg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 100% 100% at 50% 50%, transparent 40%, rgba(15, 8, 8, 0.6) 100%);
  }
  
  /* Container */
  .container {
    position: relative;
    z-index: var(--z-base);
  }
  
  /* Hero */
  .hero {
    text-align: center;
    padding-bottom: var(--space-16);
    margin-bottom: var(--space-12);
    position: relative;
  }
  
  .hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  }
  
  .hero-greeting {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
    animation: fadeInUp 0.5s ease-out;
  }

  .greeting-icon {
    display: flex;
  }

  .hero-logo {
    margin-bottom: var(--space-4);
    animation: fadeInUp 0.5s ease-out 0.1s both;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(36px, 8vw, var(--font-size-4xl));
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-3);
    animation: fadeInUp 0.5s ease-out 0.15s both;
  }

  .hero-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    letter-spacing: 0.2em;
    font-weight: var(--font-weight-light);
    margin-bottom: var(--space-4);
    animation: fadeInUp 0.5s ease-out 0.2s both;
  }

  .hero-date {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    animation: fadeInUp 0.5s ease-out 0.25s both;
  }

  .hero-date-divider {
    opacity: 0.5;
  }

  /* 文章数量 */
  .hero-count {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-3);
    animation: fadeInUp 0.5s ease-out 0.3s both;
    letter-spacing: 0.05em;
  }
  
  /* Sections */
  .sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  
  .section {
    animation: fadeInUp 0.5s ease-out 0.4s both;
  }
  
  .article-list {
    display: flex;
    flex-direction: column;
  }

  /* ── 居中单栏布局：PC 端加宽到 920px ── */
  .article-container {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }
  
  /* Footer */
  .footer {
    text-align: center;
    padding: var(--space-16) 0 var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }
  
  .footer a {
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }
  
  .footer a:hover {
    opacity: 0.8;
  }

  .build-info {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    letter-spacing: 0.05em;
  }
  
  /* Responsive */
  @media (max-width: 640px) {
    .hero {
      padding-bottom: var(--space-12);
      margin-bottom: var(--space-10);
    }

    .hero-logo svg {
      width: 40px;
      height: 40px;
    }
    
    .article-container {
      padding: 0 var(--space-3);
    }
  }
  /* ============================================
     Feature: 主页双栏布局 + 红利狙击查询面板
     (feature/dividend-web-ui)
     ============================================ */

  /* 双栏网格: 左 70% / 右 30%, 中间 gap */
  .main-split-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--space-6);
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    align-items: start;
  }
  .article-column { min-width: 0; }

  /* 右栏 sticky 跟随滚动 */
  .dividend-column {
    position: sticky;
    top: var(--space-6);
    display: flex;
    flex-direction: column;
  }
  .dividend-column-header {
    text-align: center;
    margin-bottom: var(--space-3);
  }
  .dividend-column-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1);
    background: linear-gradient(135deg, #fafafa 0%, #e60000 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .dividend-column-sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    margin: 0;
  }
  .dividend-column-foot {
    text-align: center;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: 11px;
    line-height: 1.4;
  }

  /* 磨砂玻璃面板 (从 dividend.astro 移植, 紧凑版) */
  .sniper-panel {
    background: rgba(18, 8, 8, 0.6);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(230, 0, 0, 0.18);
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .sniper-input {
    width: 100%;
    padding: 12px 14px;
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    background: rgba(10, 5, 5, 0.7);
    border: 1.5px solid var(--color-border);
    border-radius: 10px;
    outline: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }
  .sniper-input::placeholder { color: var(--color-text-muted); }
  .sniper-input:focus {
    border-color: var(--color-accent);
    background: rgba(10, 5, 5, 0.9);
    box-shadow: 0 0 0 3px var(--color-accent-dim);
  }
  .sniper-btn {
    width: 100%;
    margin-top: var(--space-3);
    padding: 12px;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    background: linear-gradient(135deg, var(--color-accent) 0%, #b30000 100%);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: 1.5px;
    box-shadow: 0 4px 16px rgba(230, 0, 0, 0.25);
  }
  .sniper-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(230, 0, 0, 0.4);
    background: linear-gradient(135deg, var(--color-accent-hover) 0%, #c20000 100%);
  }
  .sniper-btn:active { transform: translateY(0); }
  .sniper-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* 结果看板 */
  .result-board {
    margin-top: var(--space-4);
    opacity: 0;
    transform: translateY(8px);
    max-height: 0;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .result-board.visible {
    opacity: 1;
    transform: translateY(0);
    max-height: 800px;
  }
  .result-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }
  .result-cell {
    padding: var(--space-3);
    background: rgba(10, 5, 5, 0.5);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
  }
  .result-cell.full { grid-column: 1 / -1; }
  .result-label {
    font-size: 10px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }
  .result-value {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }
  .result-value.accent {
    color: var(--color-accent);
    text-shadow: 0 0 16px rgba(230, 0, 0, 0.3);
    font-size: var(--font-size-xl);
  }
  .result-meta {
    font-size: 11px;
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  /* 方案B: 现价旁的更新按钮 (2026-06-10) */
  .result-value-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }
  .result-value-row .result-value {
    flex: 1;
    min-width: 0;
  }
  .btn-refresh-price {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    background: rgba(230, 0, 0, 0.12);
    border: 1px solid rgba(230, 0, 0, 0.35);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.18s ease;
    letter-spacing: 0.3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .btn-refresh-price:hover:not(:disabled) {
    background: rgba(230, 0, 0, 0.22);
    border-color: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: 0 2px 10px rgba(230, 0, 0, 0.3);
  }
  .btn-refresh-price:active:not(:disabled) { transform: translateY(0); }
  .btn-refresh-price:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .btn-refresh-price .btn-icon {
    display: inline-block;
    font-size: 11px;
    transition: transform 0.6s ease;
  }
  .btn-refresh-price.loading .btn-icon {
    animation: spin 1s linear infinite;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .btn-refresh-price.success {
    background: rgba(34, 197, 94, 0.18);
    border-color: rgba(34, 197, 94, 0.55);
    color: #4ade80;
  }
  .result-error {
    color: var(--color-danger);
    text-align: center;
    padding: var(--space-3);
    font-size: 12px;
  }
  .sniper-loading {
    display: none;
    text-align: center;
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
    font-size: 11px;
  }
  .sniper-loading.active { display: block; }
  .sniper-loading::after { content: '⏳'; margin-right: var(--space-1); }

  /* 响应式: 窄屏折叠为单栏, 右栏变底部 */
  @media (max-width: 960px) {
    .main-split-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .dividend-column { position: static; max-width: 480px; margin: 0 auto; width: 100%; }
  }
</style>

<script>
  // Feature: 红利狙击查询 - fetch /api/dividend 并渐入渲染
  // (从 src/pages/dividend.astro 迁移)
  const sniperForm = document.getElementById('sniper-form') as HTMLFormElement | null;
  const sniperCode = document.getElementById('sniper-code') as HTMLInputElement | null;
  const sniperBtn = document.getElementById('sniper-btn') as HTMLButtonElement | null;
  const sniperLoading = document.getElementById('sniper-loading') as HTMLDivElement | null;
  const sniperResult = document.getElementById('sniper-result') as HTMLDivElement | null;
  const sniperError = document.getElementById('sniper-error') as HTMLDivElement | null;

  function sniperSetField(name: string, value: string) {
    if (!sniperResult) return;
    const el = sniperResult.querySelector<HTMLElement>(`[data-field="${name}"]`);
    if (el) el.textContent = value;
  }

  function sniperShowError(msg: string) {
    if (!sniperResult || !sniperError) return;
    sniperResult.classList.add('visible');
    sniperError.textContent = msg;
    sniperError.style.display = 'block';
  }

  function sniperClearError() {
    if (!sniperError) return;
    sniperError.textContent = '';
    sniperError.style.display = 'none';
  }

  sniperForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = (sniperCode?.value || '').trim();
    if (!code) { sniperShowError('请输入股票代码或简称'); return; }

    if (sniperBtn) sniperBtn.disabled = true;
    sniperLoading?.classList.add('active');
    sniperResult?.classList.remove('visible');
    sniperClearError();

    try {
      const res = await fetch(`/api/dividend?code=${encodeURIComponent(code)}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || `HTTP ${res.status}`);

      sniperSetField('code', data.code ?? '—');
      sniperSetField('name', data.name ?? '—');
      sniperSetField('industry', data.industry ?? '—');
      sniperSetField('current_price', typeof data.current_price === 'number' ? data.current_price.toFixed(2) : '—');
      sniperSetField('estimated_eps', typeof data.estimated_eps === 'number' ? data.estimated_eps.toFixed(2) : '—');
      sniperSetField('predicted_dividend_yield', data.predicted_dividend_yield ?? '—');
      sniperSetField('qualitative_adjustment', data.qualitative_adjustment ?? '—');
      sniperSetField('price_source', data.price_source ? `价帊源: ${data.price_source}` : '—');

      sniperResult?.classList.add('visible');
    } catch (err: any) {
      sniperShowError(`⚠️ ${err?.message || '请求失败'} (确认 Vercel api/dividend.py 已部署)`);
    } finally {
      if (sniperBtn) sniperBtn.disabled = false;
      sniperLoading?.classList.remove('active');
    }
  });

  // ── 方案B: 【🔄 更新现价】按钮点击 - 闪电拦截真价写入云端 KV ──
  const btnUpdatePrice = document.getElementById('btn-update-price');
  const lastQueriedCode = (): string => {
    const codeField = document.querySelector('[data-field=\"code\"]');
    return (codeField?.textContent || '').trim();
  };

  btnUpdatePrice?.addEventListener('click', async (e) => {
    e.preventDefault();
    const code = lastQueriedCode();
    if (!code || code === '—') {
      sniperShowError('请先在上方输入股票代码, 完成查询后再点【更新现价】');
      return;
    }
    if (btnUpdatePrice.disabled) return;

    const labelSpan = btnUpdatePrice.querySelector('.btn-label') as HTMLElement | null;
    const iconSpan = btnUpdatePrice.querySelector('.btn-icon') as HTMLElement | null;
    const originalLabel = labelSpan?.textContent || '更新现价';

    btnUpdatePrice.disabled = true;
    btnUpdatePrice.classList.add('loading');
    if (labelSpan) labelSpan.textContent = '正在重刷…';
    sniperClearError();

    try {
      const res = await fetch(`/api/dividend?code=${encodeURIComponent(code)}&action=update`);
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || data?.message || `HTTP ${res.status}`);

      // 闪电更新 DOM 现价
      if (typeof data.new_price === 'number') {
        sniperSetField('current_price', data.new_price.toFixed(2));
      }

      // 重新计算前瞻股息率 (现价 × 静态股息率常量)
      const epsField = document.querySelector('[data-field=\"estimated_eps\"]');
      const yieldField = document.querySelector('[data-field=\"predicted_dividend_yield\"]');
      const eps = parseFloat(epsField?.textContent || '0');
      const newPrice = data.new_price;
      if (newPrice && eps > 0) {
        // Mock 派息率 35% (与后端 dividend_calculator.py 未对接前的占位逻辑)
        const mockPayoutRatio = 0.35;
        const annualDividend = eps * mockPayoutRatio;
        const yieldPct = ((annualDividend / newPrice) * 100).toFixed(2);
        if (yieldField) yieldField.textContent = `${yieldPct}%`;
      }

      // 更新价帊源提示
      sniperSetField('price_source', `价帊源: ${data.price_source || '—'} · ${data.message || '重刷成功'}`);

      // 按钮变绿提示
      btnUpdatePrice.classList.add('success');
      if (labelSpan) labelSpan.textContent = '更新成功';
      if (iconSpan) iconSpan.textContent = '✅';

      setTimeout(() => {
        btnUpdatePrice.classList.remove('success');
        if (labelSpan) labelSpan.textContent = originalLabel;
        if (iconSpan) iconSpan.textContent = '🔄';
      }, 2200);
    } catch (err: any) {
      sniperShowError(`⚠️ 重刷失败: ${err?.message || '请求失败'}`);
      if (labelSpan) labelSpan.textContent = '重试';
    } finally {
      btnUpdatePrice.classList.remove('loading');
      btnUpdatePrice.disabled = false;
    }
  });
</script>
