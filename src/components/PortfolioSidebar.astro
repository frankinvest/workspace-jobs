---
/**
 * Portfolio Sidebar Component
 *
 * Build-time:
 *   - Renders Frank's holdings as a static skeleton (prices='--')
 *   - Inject holding data via data-* attributes for client-side script
 *
 * Client-side (after hydration):
 *   - Fetches live prices from /api/price every 60s
 *   - Re-renders currentPrice / positionPct / returnPct in place
 *   - Shows update timestamp + source attribution
 *
 * Layout: occupies 1/3 width on PC (right sidebar), stacks below articles on mobile.
 */
import type { Holding } from '../utils/portfolio';
import { calcHoldingStats } from '../utils/portfolio';

interface Props {
  holdings: Holding[];
}

const { holdings } = Astro.props;

// Build-time stats with no prices (placeholder for skeleton)
const emptyPrices: Record<string, null> = {};
for (const h of holdings) emptyPrices[h.code] = null;
const stats = calcHoldingStats(holdings, emptyPrices);
---

<aside class="portfolio-sidebar is-collapsed" aria-label="Frank 持仓信息">
  <button type="button" class="portfolio-toggle" aria-expanded="false" aria-controls="portfolio-body">
    <span class="portfolio-icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="20" x2="12" y2="10"></line>
        <line x1="18" y1="20" x2="18" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="16"></line>
      </svg>
    </span>
    <h2 class="portfolio-title">Frank 持仓</h2>
    <span class="portfolio-count">{holdings.length}</span>
    <span class="portfolio-chevron" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </span>
  </button>

  <div class="portfolio-body" id="portfolio-body">
    <ul class="portfolio-list" id="portfolio-list">
      {stats.map(h => (
        <li class="portfolio-item" data-code={h.code} data-shares={h.shares} data-cost={h.cost}>
          <div class="portfolio-item-row portfolio-item-top">
            <span class="portfolio-name">{h.name}</span>
            <span class="portfolio-price portfolio-price-value" data-field="currentPrice">--</span>
          </div>
          <div class="portfolio-item-meta">
            <span class="portfolio-shares">{h.shares.toLocaleString('zh-CN')} 股 · 成本 {h.cost.toFixed(3)}</span>
          </div>
          <div class="portfolio-item-stats">
            <div class="portfolio-stat">
              <span class="portfolio-stat-label">占比</span>
              <span class="portfolio-stat-value" data-field="positionPct">--</span>
            </div>
            <div class="portfolio-stat">
              <span class="portfolio-stat-label">收益率</span>
              <span class="portfolio-stat-value portfolio-return" data-field="returnPct">--</span>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <footer class="portfolio-footer">
      <span class="portfolio-update" id="portfolio-update">加载中…</span>
      <span class="portfolio-source" id="portfolio-source"></span>
    </footer>
  </div>
</aside>

<script is:inline src="/portfolio.js" type="module"></script>

<style>
  .portfolio-sidebar {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    align-self: start;
  }

  .portfolio-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    margin-bottom: var(--space-5);
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: inherit;
    font: inherit;
  }

  .portfolio-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-md);
  }

  .portfolio-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: transform var(--transition-fast);
    flex-shrink: 0;
    margin-left: auto;
  }

  .portfolio-toggle[aria-expanded="true"] .portfolio-chevron {
    transform: rotate(180deg);
  }

  .portfolio-sidebar.is-collapsed .portfolio-body {
    display: none;
  }

  .portfolio-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--color-accent-dim);
    color: var(--color-accent);
    border-radius: var(--radius-md);
  }

  .portfolio-title {
    flex: 1;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .portfolio-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 var(--space-2);
    background: var(--color-bg-elevated);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }

  .portfolio-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .portfolio-item {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--transition-fast);
  }

  .portfolio-item:hover {
    border-color: var(--color-border);
  }

  .portfolio-item-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .portfolio-item-top {
    margin-bottom: var(--space-1);
  }

  .portfolio-name {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .portfolio-price {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    font-family: var(--font-sans);
  }

  .portfolio-item-meta {
    margin-bottom: var(--space-2);
  }

  .portfolio-shares {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .portfolio-item-stats {
    display: flex;
    gap: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-2);
  }

  .portfolio-stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .portfolio-stat-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .portfolio-stat-value {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    font-family: var(--font-sans);
  }

  .portfolio-return.up {
    color: var(--color-danger); /* A 股红涨 */
  }

  .portfolio-return.down {
    color: var(--color-success); /* A 股绿跌 */
  }

  .portfolio-footer {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .portfolio-update {
    font-variant-numeric: tabular-nums;
  }
</style>
