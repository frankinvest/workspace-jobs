---
/**
 * Portfolio Sidebar Component
 *
 * Build-time:
 *   - Renders Frank's holdings as a locked skeleton (prices='--')
 *   - Inject holding data via data-* attributes for client-side script
 *
 * Client-side (after hydration):
 *   - Requires password before showing holdings
 *   - Fetches live prices from /api/price every 60s
 *   - Re-renders price / position % / P&L in place
 *   - Shows update timestamp + source attribution
 */
import type { Holding } from '../utils/portfolio';
import { calcHoldingStats } from '../utils/portfolio';

interface Props {
  holdings: Holding[];
}

const { holdings } = Astro.props;

// Build-time stats with no prices (placeholder for skeleton)
const emptyPrices: Record<string, null> = {};
for (const h of holdings) emptyPrices[h.code] = null;
const stats = calcHoldingStats(holdings, emptyPrices);
---

<aside class="portfolio-sidebar is-collapsed is-amount-locked" aria-label="Frank 持仓信息">
  <div class="portfolio-header">
    <div class="portfolio-heading">
      <span class="portfolio-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="20" x2="12" y2="10"></line>
          <line x1="18" y1="20" x2="18" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="16"></line>
        </svg>
      </span>
      <div class="portfolio-heading-text">
        <h2 class="portfolio-title">Frank 持仓</h2>
        <p class="portfolio-subtitle">仓位分布 · 持仓盈亏</p>
      </div>
    </div>

    <div class="portfolio-actions">
      <button type="button" class="portfolio-lock-btn" aria-expanded="false" aria-controls="portfolio-gate">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>输入密码查看盈亏</span>
      </button>
      <button type="button" class="portfolio-collapse-btn" aria-expanded="false" aria-controls="portfolio-body">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <div class="portfolio-gate" id="portfolio-gate">
    <form class="portfolio-gate-form" id="portfolio-gate-form" autocomplete="off">
      <label class="portfolio-gate-label" for="portfolio-password">持仓密码</label>
      <div class="portfolio-gate-row">
        <input type="password" id="portfolio-password" name="password" placeholder="请输入密码" autocomplete="off" />
        <button type="submit">解锁</button>
      </div>
      <p class="portfolio-gate-error" id="portfolio-gate-error" role="alert" hidden>密码不正确，请重试</p>
    </form>
  </div>

  <div class="portfolio-body" id="portfolio-body">
    <div class="portfolio-summary">
      <div class="portfolio-summary-cell">
        <span class="portfolio-summary-label">总市值</span>
        <strong class="portfolio-summary-value" id="portfolio-total-value">***</strong>
      </div>
      <div class="portfolio-summary-cell">
        <span class="portfolio-summary-label">持仓盈亏</span>
        <strong class="portfolio-summary-value portfolio-return" id="portfolio-total-pnl">***</strong>
      </div>
      <div class="portfolio-summary-cell">
        <span class="portfolio-summary-label">总收益率</span>
        <strong class="portfolio-summary-value portfolio-return" id="portfolio-total-return">--</strong>
      </div>
    </div>

    <ul class="portfolio-list" id="portfolio-list">
      {stats.map(h => (
        <li class="portfolio-item" data-code={h.code} data-shares={h.shares} data-cost={h.cost}>
          <div class="portfolio-item-head">
            <span class="portfolio-name">{h.name}</span>
            <span class="portfolio-price">
              <span class="portfolio-price-value" data-field="currentPrice">--</span>
            </span>
          </div>

          <div class="portfolio-position">
            <div class="portfolio-position-meta">
              <span class="portfolio-position-label">仓位占比</span>
              <span class="portfolio-position-value" data-field="positionPct">--</span>
            </div>
            <div class="portfolio-position-track" aria-hidden="true">
              <div class="portfolio-position-fill" data-field="positionBar"></div>
            </div>
          </div>

          <div class="portfolio-pnl">
            <span class="portfolio-pnl-label">持仓盈亏</span>
            <div class="portfolio-pnl-values">
              <span class="portfolio-pnl-rate portfolio-return" data-field="returnPct">--</span>
              <span class="portfolio-pnl-amount" data-field="pnlAmount">***</span>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <footer class="portfolio-footer">
      <span class="portfolio-update" id="portfolio-update">加载中…</span>
      <span class="portfolio-source" id="portfolio-source"></span>
    </footer>
  </div>
</aside>

<script is:inline src="/portfolio.js" type="module"></script>

<style>
  .portfolio-sidebar {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-md);
  }

  .portfolio-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .portfolio-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .portfolio-heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .portfolio-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background: var(--color-accent-dim);
    color: var(--color-accent);
    border-radius: var(--radius-md);
  }

  .portfolio-heading-text {
    min-width: 0;
  }

  .portfolio-title {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .portfolio-subtitle {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }

  .portfolio-lock-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: transparent;
    border: 1px solid var(--color-accent-dim);
    border-radius: var(--radius-md);
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    cursor: pointer;
    flex-shrink: 0;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .portfolio-lock-btn:hover {
    background: var(--color-accent-dim);
    border-color: var(--color-accent);
  }

  .portfolio-lock-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .portfolio-collapse-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .portfolio-collapse-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-muted);
  }

  .portfolio-collapse-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .portfolio-collapse-btn svg {
    transition: transform var(--transition-fast);
  }

  .portfolio-sidebar:not(.is-collapsed) .portfolio-collapse-btn svg {
    transform: rotate(180deg);
  }

  .portfolio-gate {
    display: none;
    margin-top: var(--space-5);
  }

  .portfolio-sidebar.is-gate-open .portfolio-gate {
    display: block;
  }

  .portfolio-gate-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .portfolio-gate-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .portfolio-gate-row {
    display: flex;
    gap: var(--space-2);
  }

  .portfolio-gate-row input {
    flex: 1;
    min-width: 0;
    height: 38px;
    padding: 0 var(--space-3);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    font-family: inherit;
  }

  .portfolio-gate-row input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .portfolio-gate-row button {
    height: 38px;
    padding: 0 var(--space-4);
    background: var(--color-accent);
    border: none;
    border-radius: var(--radius-md);
    color: white;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }

  .portfolio-gate-row button:hover {
    background: var(--color-accent-hover);
  }

  .portfolio-gate-error {
    font-size: var(--font-size-xs);
    color: var(--color-danger);
    margin: 0;
  }

  .portfolio-body {
    display: none;
  }

  .portfolio-sidebar.is-collapsed .portfolio-body {
    display: none;
  }

  .portfolio-sidebar:not(.is-collapsed) .portfolio-body {
    display: block;
    margin-top: var(--space-5);
  }

  .portfolio-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .portfolio-summary-cell {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    min-width: 0;
  }

  .portfolio-summary-label {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .portfolio-summary-value {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .portfolio-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .portfolio-item {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--transition-fast);
  }

  .portfolio-item:hover {
    border-color: var(--color-border);
  }

  .portfolio-item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .portfolio-name {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .portfolio-price {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .portfolio-position {
    margin-bottom: var(--space-3);
  }

  .portfolio-position-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-1);
  }

  .portfolio-position-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .portfolio-position-value {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .portfolio-position-track {
    height: 6px;
    background: var(--color-bg-elevated);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .portfolio-position-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-hover));
    border-radius: var(--radius-full);
    transition: width var(--transition-slow);
  }

  .portfolio-pnl {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-subtle);
  }

  .portfolio-pnl-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .portfolio-pnl-values {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-width: 0;
  }

  .portfolio-pnl-rate {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .portfolio-pnl-amount {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .portfolio-return.up {
    color: var(--color-danger); /* A 股红涨 */
  }

  .portfolio-return.down {
    color: var(--color-success); /* A 股绿跌 */
  }

  .portfolio-footer {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .portfolio-update {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .portfolio-summary {
      gap: var(--space-2);
    }

    .portfolio-summary-value {
      font-size: var(--font-size-xs);
    }
  }
</style>
