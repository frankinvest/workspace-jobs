---
// StockList.astro - 动态加载个股数据
---

<div class="stock-list" id="stock-list">
  <div class="stock-header">
    <span class="stock-title">热门个股</span>
    <span class="stock-subtitle">每日动态更新</span>
  </div>

  <div class="stock-table" id="stock-table">
    <div class="table-head">
      <span>名称</span>
      <span>现价</span>
      <span>涨跌幅</span>
    </div>

    <!-- 由 JS 动态加载 -->
  </div>
</div>

<script>
  const initStockList = () => {
    const loadStocks = async () => {
      try {
        const response = await fetch('/api/update-market');
        const data = await response.json();

        if (data.success) {
          renderStocks(data.stocks || []);
        }
      } catch (error) {
        console.error('加载个股失败:', error);
      }
    };

    const renderStocks = (stocks) => {
      const table = document.getElementById('stock-table');
      if (!table) return;

      // 保留表头
      const header = table.querySelector('.table-head');
      table.innerHTML = '';
      table.appendChild(header);

      stocks.forEach(stock => {
        const row = document.createElement('div');
        const isUp = stock.change > 0;
        const isDown = stock.change < 0;
        const trendColor = isUp ? 'color-up' : isDown ? 'color-down' : 'color-flat';
        const trendClass = getTrendClass(stock.change);
        row.className = `table-row ${trendClass} ${trendColor}`;
        row.innerHTML = `
          <div class="stock-name">
            <span class="name-text">${stock.name}</span>
            <span class="stock-code">${stock.code}</span>
          </div>
          <div class="stock-price">${formatPrice(stock.price)}</div>
          <div class="stock-change">
            ${isUp ? '+' : ''}${stock.change_pct.toFixed(2)}%
          </div>
        `;
        table.appendChild(row);
      });
    };

    const getTrendClass = (change) => {
      if (change > 0) return 'trend-up';
      if (change < 0) return 'trend-down';
      return 'trend-flat';
    };

    const formatPrice = (price) => {
      if (price >= 10000) {
        return price.toLocaleString('en-US', { maximumFractionDigits: 0 });
      }
      return price.toLocaleString('en-US', { maximumFractionDigits: 2 });
    };

    // 初始化
    loadStocks();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStockList);
  } else {
    initStockList();
  }
</script>

<style>
  .stock-list {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 24px;
  }

  .stock-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .stock-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
  }

  .stock-subtitle {
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .stock-table {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .table-head {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 12px;
    padding: 8px 12px;
    font-size: 11px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .table-head span:not(:first-child) {
    text-align: right;
  }

  .table-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 12px;
    padding: 10px 12px;
    background: var(--color-bg);
    border-radius: 6px;
    font-size: 13px;
    align-items: center;
  }

  .table-row.trend-up {
    border-left: 2px solid var(--color-danger);
  }

  .table-row.trend-down {
    border-left: 2px solid var(--color-success);
  }

  .table-row.trend-flat {
    border-left: 2px solid var(--color-border);
  }

  .stock-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .name-text {
    font-weight: 500;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stock-code {
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .stock-price {
    font-family: var(--font-serif);
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
  }

  .stock-change {
    text-align: right;
    white-space: nowrap;
    font-weight: 500;
  }

  /* ── 红涨绿跌染色 ── */
  .color-up,
  .color-up .stock-price,
  .color-up .stock-change {
    color: var(--color-danger);
  }
  .color-down,
  .color-down .stock-price,
  .color-down .stock-change {
    color: var(--color-success);
  }
  .color-flat,
  .color-flat .stock-price,
  .color-flat .stock-change {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .table-head {
      display: none;
    }

    .table-row {
      grid-template-columns: 1fr auto auto;
    }
  }
</style>
