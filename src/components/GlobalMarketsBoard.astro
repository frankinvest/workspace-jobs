---
// GlobalMarketsBoard.astro
// 「纵横东西」模块：常见大宗期货 + 美股/亚太指数价格
// 数据来源: /api/global-markets (Vercel serverless，多源 race + 5min 缓存)
// Frank 2026-09-07 17:57 新增任务
const CATEGORY_ORDER = ['energy', 'precious', 'metals', 'agriculture', 'us_index', 'asia_index'] as const;
---

<section class="global-markets" aria-label="纵横东西">
  <header class="gm-header">
    <h2 class="gm-title">🌐 纵横东西</h2>
    <p class="gm-sub">大宗期货 · 美股 · 亚太指数</p>
  </header>

  <div class="gm-board" id="global-markets-board" data-loading="true">
    <div class="gm-skeleton">
      <span>正在拉取全球行情…</span>
    </div>
  </div>

  <div class="gm-footer">
    <span class="gm-source">数据来源：腾讯财经 + Yahoo Finance</span>
    <span class="gm-updated" id="global-markets-updated"></span>
  </div>
</section>

<style>
  .global-markets {
    max-width: 1200px;
    margin: 0 auto var(--space-12);
    padding: var(--space-6) var(--space-4);
    background: var(--color-bg-elevated, #14171f);
    border-radius: 12px;
    border: 1px solid var(--color-border, #2a2f3a);
  }

  .gm-header {
    margin-bottom: var(--space-5);
  }

  .gm-title {
    font-size: var(--font-size-xl, 1.5rem);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text, #e5e7eb);
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .gm-sub {
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, #9ca3af);
    margin: var(--space-1) 0 0;
  }

  /* 6 分类网格：默认 3 列 */
  .gm-board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  @media (max-width: 1024px) {
    .gm-board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .gm-board {
      grid-template-columns: 1fr;
    }
  }

  .gm-skeleton {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-12) 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .gm-category {
    background: var(--color-bg, #0f1117);
    border: 1px solid var(--color-border, #2a2f3a);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* 分类顶部色条 */
  .gm-cat-bar {
    height: 3px;
    width: 100%;
  }

  .gm-cat-bar-energy     { background: #f97316; } /* 能源：橙 */
  .gm-cat-bar-precious   { background: #eab308; } /* 贵金属：金黄 */
  .gm-cat-bar-metals     { background: #6366f1; } /* 有色：靛蓝 */
  .gm-cat-bar-agriculture{ background: #84cc16; } /* 农产品：草绿 */
  .gm-cat-bar-us_index   { background: #3b82f6; } /* 美股：蓝 */
  .gm-cat-bar-asia_index { background: #ec4899; } /* 亚太：粉 */

  .gm-cat-label {
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-base, 1rem);
    font-weight: var(--font-weight-medium, 500);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }

  .gm-items {
    display: flex;
    flex-direction: column;
  }

  .gm-item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: background var(--transition-fast, 150ms ease);
  }

  .gm-item:last-child {
    border-bottom: none;
  }

  .gm-item:hover {
    background: var(--color-bg-hover, #1a1f2b);
  }

  .gm-item-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .gm-item-name-zh {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gm-item-unit {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted);
  }

  .gm-item-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    font-variant-numeric: tabular-nums;
  }

  .gm-item-price-value {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
  }

  .gm-item-change {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
  }

  .gm-item-change.up {
    color: #ef4444; /* A 股惯例：红涨绿跌 */
  }

  .gm-item-change.down {
    color: #22c55e;
  }

  .gm-item-change.flat {
    color: var(--color-text-muted);
  }

  .gm-item-arrow {
    font-size: 0.75em;
  }

  .gm-item-empty {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .gm-footer {
    margin-top: var(--space-4);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .gm-error {
    grid-column: 1 / -1;
    padding: var(--space-4);
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 6px;
    color: #fca5a5;
    font-size: var(--font-size-sm);
    text-align: center;
  }
</style>

<script>
  // 客户端拉取 + 渲染（每 5 分钟轮询一次，与服务端 5min 缓存同步）
  const board = document.getElementById('global-markets-board');
  const updatedEl = document.getElementById('global-markets-updated');
  const REFRESH_MS = 5 * 60 * 1000; // 5 min

  // 分类色条类名
  const BAR_CLASS = {
    energy: 'gm-cat-bar-energy',
    precious: 'gm-cat-bar-precious',
    metals: 'gm-cat-bar-metals',
    agriculture: 'gm-cat-bar-agriculture',
    us_index: 'gm-cat-bar-us_index',
    asia_index: 'gm-cat-bar-asia_index',
  };

  // 分类显示名
  const CATEGORY_LABELS = {
    energy: '⚡ 能源',
    precious: '🥇 贵金属',
    metals: '🔩 有色金属',
    agriculture: '🌾 农产品',
    us_index: '🇺🇸 美股指数',
    asia_index: '🌏 亚太指数',
  };

  function fmtPrice(p) {
    if (p == null || isNaN(p)) return '—';
    if (p >= 10000) return p.toLocaleString('en-US', { maximumFractionDigits: 0 });
    if (p >= 100) return p.toFixed(2);
    if (p >= 10) return p.toFixed(3);
    return p.toFixed(4);
  }

  function fmtChangePct(p) {
    if (p == null || isNaN(p)) return null;
    return (p >= 0 ? '+' : '') + p.toFixed(2) + '%';
  }

  function renderCategory(catKey, catData) {
    const items = catData.items || [];
    const barClass = BAR_CLASS[catKey] || '';
    const label = catData.label || CATEGORY_LABELS[catKey] || catKey;

    const itemsHtml = items.map(it => {
      const price = it.price;
      const change = it.changePct;
      const changeText = fmtChangePct(change);
      let changeCls = 'flat';
      let arrow = '—';
      if (change != null && !isNaN(change)) {
        if (change > 0) { changeCls = 'up'; arrow = '▲'; }
        else if (change < 0) { changeCls = 'down'; arrow = '▼'; }
        else { changeCls = 'flat'; arrow = '—'; }
      }
      const priceHtml = price != null
        ? `<span class="gm-item-price-value">${fmtPrice(price)}</span>`
        : `<span class="gm-item-price-value gm-item-empty">暂无</span>`;
      const changeHtml = changeText != null
        ? `<span class="gm-item-change ${changeCls}"><span class="gm-item-arrow">${arrow}</span>${changeText}</span>`
        : `<span class="gm-item-change flat">—</span>`;
      return `<div class="gm-item">
        <div class="gm-item-name">
          <span class="gm-item-name-zh">${escapeHtml(it.nameZh || it.code)}</span>
          <span class="gm-item-unit">${escapeHtml(it.unit || '')}</span>
        </div>
        <div class="gm-item-price">
          ${priceHtml}
          ${changeHtml}
        </div>
      </div>`;
    }).join('');

    return `<div class="gm-category">
      <div class="gm-cat-bar ${barClass}"></div>
      <div class="gm-cat-label">${escapeHtml(label)}</div>
      <div class="gm-items">${itemsHtml}</div>
    </div>`;
  }

  function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, ch => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[ch] || ch));
  }

  function render(payload) {
    if (!board) return;
    const cats = payload.categories || {};
    const html = Object.entries(cats).map(([k, v]) => renderCategory(k, v)).join('');
    board.innerHTML = html || '<div class="gm-error">暂无数据</div>';

    if (updatedEl) {
      const t = new Date(payload.asOf || Date.now());
      const ts = t.toLocaleString('zh-CN', { hour12: false, timeZone: 'Asia/Shanghai' });
      updatedEl.textContent = `快照：${ts}${payload.cached ? '（缓存）' : ''}`;
    }
  }

  async function fetchAndRender() {
    if (!board) return;
    try {
      const r = await fetch('/api/global-markets', { cache: 'no-store' });
      if (!r.ok) throw new Error('http ' + r.status);
      const data = await r.json();
      render(data);
    } catch (err) {
      if (board) {
        board.innerHTML = `<div class="gm-error">⚠️ 实时行情获取失败（${escapeHtml(String(err && err.message || err))}）。请稍后重试。</div>`;
      }
      if (updatedEl) updatedEl.textContent = '快照：—';
    }
  }

  fetchAndRender();
  setInterval(fetchAndRender, REFRESH_MS);
</script>
