---
// GlobalMarketsBoard.astro
// 「纵横东西」模块：重点行情（9 项置顶）+ 其余分类折叠
// 数据来源: /api/global-markets (Vercel serverless，多源 + 5min 缓存)
// Frank 2026-09-07 19:25 反馈：布局优化 + 重点 9 项 + 其余折叠
// Frank 2026-09-07 19:47 反馈：设计感 + 不粗糙 + 强化精致度（小秘 19:50 重写）
// Codex 19:51 边界：只动本文件 CSS/markup，不碰 api/global-markets.js
const CATEGORY_ORDER = ['energy', 'precious', 'metals', 'agriculture', 'us_index', 'asia_index', 'cn_index'];
---

<section class="global-markets" aria-label="纵横东西">
  <span class="gm-glow gm-glow-1" aria-hidden="true"></span>
  <span class="gm-glow gm-glow-2" aria-hidden="true"></span>

  <header class="gm-header">
    <h2 class="gm-title">🌐 纵横东西</h2>
    <p class="gm-sub">大宗期货 · 美股 · 亚太 · 中国指数</p>
  </header>

  <!-- 重点行情：9 项永远可见，大字卡片 -->
  <div class="gm-featured">
    <div class="gm-featured-head">
      <h3 class="gm-featured-title">🔥 重点行情</h3>
      <span class="gm-updated" id="global-markets-updated"></span>
    </div>
    <div class="gm-featured-grid" id="gm-featured-grid">
      <div class="gm-skeleton">正在拉取全球行情…</div>
    </div>
  </div>

  <!-- 其余行情：默认折叠 -->
  <div class="gm-cats" id="gm-cats"></div>

  <footer class="gm-footer">
    <span class="gm-source">数据来源 · 腾讯财经 · 新浪财经 · Yahoo Finance</span>
    <span class="gm-refresh">⏱ 每 5 分钟刷新</span>
  </footer>
</section>

<style>
  /* ── 设计令牌 ── */
  :root {
    --gm-radius-card: 12px;
    --gm-radius-badge: 6px;
    --gm-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --gm-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --gm-up: #ef4444;
    --gm-up-bg: rgba(239, 68, 68, 0.12);
    --gm-up-border: rgba(239, 68, 68, 0.22);
    --gm-up-text: #fca5a5;
    --gm-down: #22c55e;
    --gm-down-bg: rgba(34, 197, 94, 0.12);
    --gm-down-border: rgba(34, 197, 94, 0.22);
    --gm-down-text: #86efac;
    --gm-flat: #9ca3af;
    --gm-flat-bg: rgba(156, 163, 175, 0.08);
    --gm-flat-border: rgba(156, 163, 175, 0.18);
  }

  /* ── 主容器：磨砂玻璃 + 多层阴影 + 渐变光晕 ── */
  .global-markets {
    position: relative;
    max-width: 1200px;
    margin: 0 auto var(--space-12, 3rem);
    padding: var(--space-8, 2rem) var(--space-6, 1.5rem);
    background:
      linear-gradient(135deg, rgba(20, 23, 31, 0.72), rgba(15, 17, 23, 0.58));
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 24px 64px rgba(0, 0, 0, 0.42),
      0 8px 20px rgba(0, 0, 0, 0.24);
    overflow: hidden;
  }

  /* SVG 渐变光晕背景（CSS-only radial-gradient） */
  .gm-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(60px);
    opacity: 0.55;
  }
  .gm-glow-1 {
    top: -120px;
    left: -120px;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.28) 0%, transparent 65%);
    animation: gm-glow-drift 9s ease-in-out infinite;
  }
  .gm-glow-2 {
    bottom: -160px;
    right: -160px;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.22) 0%, transparent 65%);
    animation: gm-glow-drift 11s ease-in-out infinite reverse;
  }
  @keyframes gm-glow-drift {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.55; }
    50% { transform: translate(20px, -20px) scale(1.08); opacity: 0.75; }
  }

  /* ── 标题区 ── */
  .gm-header {
    margin-bottom: var(--space-6, 1.5rem);
    position: relative;
    z-index: 1;
  }
  .gm-title {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 700;
    background: linear-gradient(135deg, #e5e7eb 0%, #94a3b8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
  }
  .gm-sub {
    margin: var(--space-1, 0.25rem) 0 0;
    font-size: 0.875rem;
    color: rgba(156, 163, 175, 0.9);
    letter-spacing: 0.02em;
  }

  /* ── 重点行情区 ── */
  .gm-featured {
    margin-bottom: var(--space-6, 1.5rem);
    position: relative;
    z-index: 1;
  }
  .gm-featured-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4, 1rem);
    gap: var(--space-2, 0.5rem);
  }
  .gm-featured-title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #e5e7eb;
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
  }
  .gm-featured-title::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 18px;
    background: linear-gradient(180deg, #f97316, #ef4444);
    border-radius: 2px;
    box-shadow: 0 0 8px rgba(239, 68, 68, 0.4);
  }
  .gm-updated {
    font-size: 0.75rem;
    color: rgba(156, 163, 175, 0.85);
    font-variant-numeric: tabular-nums;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .gm-featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4, 1rem);
  }

  /* ── 重点卡片：渐入动画 + 涨跌方向背景 + hover 微上浮 ── */
  .gm-fcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
    min-width: 0;
    padding: var(--space-5, 1.25rem);
    border-radius: var(--gm-radius-card);
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: linear-gradient(135deg, rgba(15, 17, 23, 0.82), rgba(20, 23, 31, 0.62));
    backdrop-filter: blur(8px);
    overflow: hidden;
    cursor: default;
    transition:
      transform 260ms var(--gm-ease),
      border-color 260ms var(--gm-ease),
      box-shadow 260ms var(--gm-ease),
      background 260ms var(--gm-ease);
    animation: gm-fadeup 520ms var(--gm-ease-out) backwards;
  }
  .gm-fcard::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.18) 100%);
  }
  .gm-fcard[data-direction="up"] {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.10) 0%, rgba(15, 17, 23, 0.72) 60%);
    border-color: rgba(239, 68, 68, 0.16);
  }
  .gm-fcard[data-direction="down"] {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.10) 0%, rgba(15, 17, 23, 0.72) 60%);
    border-color: rgba(34, 197, 94, 0.16);
  }
  .gm-fcard:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 14px 28px rgba(0, 0, 0, 0.32),
      0 4px 10px rgba(0, 0, 0, 0.22);
  }
  .gm-fcard:focus-within {
    outline: 2px solid rgba(96, 165, 250, 0.55);
    outline-offset: 2px;
  }
  @keyframes gm-fadeup {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .gm-fcard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2, 0.5rem);
    min-width: 0;
  }
  .gm-fcard-name {
    font-size: 0.9375rem;
    font-weight: 500;
    color: #e5e7eb;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gm-fcard-unit {
    font-size: 0.75rem;
    color: rgba(156, 163, 175, 0.8);
    flex-shrink: 0;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }
  .gm-fcard-price {
    font-size: 2.25rem;
    line-height: 1.05;
    font-weight: 700;
    color: #f3f4f6;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.025em;
    transition: transform 260ms var(--gm-ease);
    position: relative;
    z-index: 1;
  }
  .gm-fcard:hover .gm-fcard-price {
    transform: scale(1.02);
  }

  /* ── 涨跌徽章（图标 + 文本 + 色块三通道）── */
  .gm-change {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: fit-content;
    padding: 3px 8px;
    border-radius: var(--gm-radius-badge);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
    transition: transform 200ms var(--gm-ease), filter 200ms var(--gm-ease);
  }
  .gm-change:hover { filter: brightness(1.15); }
  .gm-change.up {
    color: var(--gm-up-text);
    background: var(--gm-up-bg);
    border: 1px solid var(--gm-up-border);
  }
  .gm-change.down {
    color: var(--gm-down-text);
    background: var(--gm-down-bg);
    border: 1px solid var(--gm-down-border);
  }
  .gm-change.flat {
    color: var(--gm-flat);
    background: var(--gm-flat-bg);
    border: 1px solid var(--gm-flat-border);
  }
  .gm-arrow {
    font-size: 0.75em;
    font-weight: 700;
  }

  /* ── 其余行情（折叠分类）── */
  .gm-cats {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    position: relative;
    z-index: 1;
  }
  details.gm-cat {
    background: linear-gradient(135deg, rgba(15, 17, 23, 0.72), rgba(20, 23, 31, 0.5));
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 260ms var(--gm-ease), box-shadow 260ms var(--gm-ease);
  }
  details.gm-cat[open] {
    border-color: rgba(255, 255, 255, 0.10);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }

  summary.gm-cat-label {
    cursor: pointer;
    list-style: none;
    padding: var(--space-4, 1rem) var(--space-5, 1.25rem);
    font-size: 1rem;
    font-weight: 600;
    color: #e5e7eb;
    background: rgba(15, 17, 23, 0.5);
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    user-select: none;
    transition: background 240ms var(--gm-ease);
    position: relative;
  }
  summary.gm-cat-label:hover { background: rgba(15, 17, 23, 0.72); }
  summary.gm-cat-label::-webkit-details-marker { display: none; }

  /* 折叠箭头：cubic-bezier 缓动 */
  summary.gm-cat-label::before {
    content: '▸';
    display: inline-block;
    transition: transform 320ms var(--gm-ease), color 240ms var(--gm-ease);
    color: rgba(156, 163, 175, 0.85);
    font-size: 0.875rem;
    width: 14px;
    text-align: center;
  }
  details[open] summary.gm-cat-label::before {
    transform: rotate(90deg);
    color: #cbd5e1;
  }

  .gm-cat-icon {
    font-size: 1.0625rem;
    line-height: 1;
    filter: saturate(1.15);
  }
  .gm-cat-count {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(156, 163, 175, 0.9);
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-variant-numeric: tabular-nums;
  }

  .gm-cat-bar {
    height: 3px;
    width: 100%;
    opacity: 0.85;
  }
  .gm-cat-bar-energy      { background: linear-gradient(90deg, #f97316, #fb923c); }
  .gm-cat-bar-precious    { background: linear-gradient(90deg, #eab308, #facc15); }
  .gm-cat-bar-metals      { background: linear-gradient(90deg, #6366f1, #818cf8); }
  .gm-cat-bar-agriculture { background: linear-gradient(90deg, #84cc16, #a3e635); }
  .gm-cat-bar-us_index    { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
  .gm-cat-bar-asia_index  { background: linear-gradient(90deg, #ec4899, #f472b6); }
  .gm-cat-bar-cn_index    { background: linear-gradient(90deg, #ef4444, #f87171); }

  .gm-cat-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-3, 0.75rem);
    padding: var(--space-3, 0.75rem) var(--space-5, 1.25rem) var(--space-4, 1rem);
  }

  .gm-item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-3, 0.75rem);
    margin: 0 calc(-1 * var(--space-2, 0.5rem));
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    transition: background 200ms var(--gm-ease);
  }
  .gm-item:hover { background: rgba(255, 255, 255, 0.03); }
  .gm-item:last-child { border-bottom: none; }

  .gm-item-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .gm-item-name-zh {
    font-size: 0.9375rem;
    font-weight: 500;
    color: #e5e7eb;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gm-item-unit {
    font-size: 0.75rem;
    color: rgba(156, 163, 175, 0.85);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .gm-item-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    font-variant-numeric: tabular-nums;
  }
  .gm-item-price-value {
    font-size: 1.0625rem;
    font-weight: 600;
    color: #f3f4f6;
    letter-spacing: -0.015em;
  }
  .gm-item-empty { color: rgba(156, 163, 175, 0.8); font-style: italic; }

  /* ── 骨架 / 错误 / footer ── */
  .gm-skeleton {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-10, 2.5rem) 0;
    color: rgba(156, 163, 175, 0.9);
    font-size: 0.875rem;
  }
  .gm-error {
    grid-column: 1 / -1;
    padding: var(--space-4, 1rem);
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
    color: #fca5a5;
    font-size: 0.875rem;
    text-align: center;
  }
  .gm-footer {
    margin-top: var(--space-6, 1.5rem);
    padding-top: var(--space-4, 1rem);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.75rem;
    color: rgba(156, 163, 175, 0.85);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
    position: relative;
    z-index: 1;
  }
  .gm-source, .gm-refresh {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    letter-spacing: 0.02em;
  }

  /* ── 响应式 ── */
  @media (max-width: 1024px) {
    .gm-featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .global-markets {
      padding: var(--space-5, 1.25rem) var(--space-4, 1rem);
      border-radius: 12px;
    }
    .gm-title { font-size: 1.5rem; }
    .gm-featured-grid { grid-template-columns: 1fr; gap: var(--space-3, 0.75rem); }
    .gm-fcard { padding: var(--space-4, 1rem); }
    .gm-fcard-price { font-size: 1.875rem; }
    .gm-cat-items { grid-template-columns: 1fr; }
    .gm-glow-1, .gm-glow-2 { opacity: 0.35; }
  }

  /* ── 用户偏好：减少动效 ── */
  @media (prefers-reduced-motion: reduce) {
    .gm-glow, .gm-fcard, .gm-fcard-price, .gm-item, .gm-change,
    summary.gm-cat-label::before, details.gm-cat, summary.gm-cat-label {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const featuredGrid = document.getElementById('gm-featured-grid');
  const catsEl = document.getElementById('gm-cats');
  const updatedEl = document.getElementById('global-markets-updated');
  const REFRESH_MS = 5 * 60 * 1000;

  const CATEGORY_ORDER = ['energy', 'precious', 'metals', 'agriculture', 'us_index', 'asia_index', 'cn_index'];

  const BAR_CLASS = {
    energy: 'gm-cat-bar-energy',
    precious: 'gm-cat-bar-precious',
    metals: 'gm-cat-bar-metals',
    agriculture: 'gm-cat-bar-agriculture',
    us_index: 'gm-cat-bar-us_index',
    asia_index: 'gm-cat-bar-asia_index',
    cn_index: 'gm-cat-bar-cn_index',
  };

  const CATEGORY_ICONS = {
    energy: '⚡',
    precious: '🥇',
    metals: '🔩',
    agriculture: '🌾',
    us_index: '🇺🇸',
    asia_index: '🌏',
    cn_index: '🇨🇳',
  };

  const CATEGORY_LABELS = {
    energy: '能源',
    precious: '贵金属',
    metals: '有色金属',
    agriculture: '农产品',
    us_index: '美股指数',
    asia_index: '亚太指数',
    cn_index: '中国指数',
  };

  function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, ch => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[ch] || ch));
  }

  function fmtPrice(p) {
    if (p == null || isNaN(p)) return '—';
    if (p >= 10000) return p.toLocaleString('en-US', { maximumFractionDigits: 0 });
    if (p >= 100) return p.toFixed(2);
    if (p >= 10) return p.toFixed(3);
    return p.toFixed(4);
  }

  function fmtChangePct(p) {
    if (p == null || isNaN(p)) return null;
    return (p >= 0 ? '+' : '') + p.toFixed(2) + '%';
  }

  function dirOf(pct) {
    if (pct == null || isNaN(pct)) return 'flat';
    if (pct > 0) return 'up';
    if (pct < 0) return 'down';
    return 'flat';
  }

  function changeHtml(change) {
    const text = fmtChangePct(change);
    if (text == null) return `<span class="gm-change flat"><span class="gm-arrow">—</span>—</span>`;
    const cls = dirOf(change);
    const arrow = cls === 'up' ? '▲' : cls === 'down' ? '▼' : '—';
    return `<span class="gm-change ${cls}"><span class="gm-arrow">${arrow}</span>${escapeHtml(text)}</span>`;
  }

  function renderFeatured(items) {
    if (!featuredGrid) return;
    if (!items.length) {
      featuredGrid.innerHTML = '<div class="gm-skeleton">暂无数据</div>';
      return;
    }
    featuredGrid.innerHTML = items.map((it, i) => {
      const dir = dirOf(it.changePct);
      const priceHtml = it.price != null
        ? `<span class="gm-fcard-price">${fmtPrice(it.price)}</span>`
        : `<span class="gm-fcard-price gm-item-empty">暂无</span>`;
      const delay = `${i * 40}ms`;
      return `<div class="gm-fcard" data-direction="${dir}" style="animation-delay:${delay}">
        <div class="gm-fcard-top">
          <span class="gm-fcard-name">${escapeHtml(it.nameZh || it.code)}</span>
          <span class="gm-fcard-unit">${escapeHtml(it.unit || '')}</span>
        </div>
        ${priceHtml}
        ${changeHtml(it.changePct)}
      </div>`;
    }).join('');
  }

  function renderCategory(catKey, catData) {
    const items = (catData.items || []).filter(it => !it.featured);
    if (!items.length) return '';
    const barClass = BAR_CLASS[catKey] || '';
    const icon = CATEGORY_ICONS[catKey] || '';
    const label = catData.label || CATEGORY_LABELS[catKey] || catKey;
    const itemsHtml = items.map(it => {
      const priceHtml = it.price != null
        ? `<span class="gm-item-price-value">${fmtPrice(it.price)}</span>`
        : `<span class="gm-item-price-value gm-item-empty">暂无</span>`;
      return `<div class="gm-item">
        <div class="gm-item-name">
          <span class="gm-item-name-zh">${escapeHtml(it.nameZh || it.code)}</span>
          <span class="gm-item-unit">${escapeHtml(it.unit || '')}</span>
        </div>
        <div class="gm-item-price">
          ${priceHtml}
          ${changeHtml(it.changePct)}
        </div>
      </div>`;
    }).join('');
    return `<details class="gm-cat">
      <div class="gm-cat-bar ${barClass}"></div>
      <summary class="gm-cat-label">
        <span class="gm-cat-icon">${icon}</span>
        <span>${escapeHtml(label)}</span>
        <span class="gm-cat-count">${items.length} 项</span>
      </summary>
      <div class="gm-cat-items">${itemsHtml}</div>
    </details>`;
  }

  function render(payload) {
    const cats = payload.categories || {};
    const featured = [];
    for (const cat of Object.values(cats)) {
      for (const it of (cat.items || [])) {
        if (it.featured) featured.push(it);
      }
    }
    renderFeatured(featured);

    if (catsEl) {
      const html = CATEGORY_ORDER.map(k => cats[k] ? renderCategory(k, cats[k]) : '').join('');
      catsEl.innerHTML = html || '<div class="gm-error">暂无更多行情</div>';
    }

    if (updatedEl) {
      const t = new Date(payload.asOf || Date.now());
      updatedEl.textContent = '快照 ' + t.toLocaleString('zh-CN', { hour12: false, timeZone: 'Asia/Shanghai' });
    }
  }

  async function fetchAndRender() {
    try {
      const r = await fetch('/api/global-markets', { cache: 'no-store' });
      if (!r.ok) throw new Error('http ' + r.status);
      render(await r.json());
    } catch (err) {
      if (featuredGrid) {
        featuredGrid.innerHTML = `<div class="gm-error">⚠️ 实时行情获取失败（${escapeHtml(String(err && err.message || err))}）。请稍后重试。</div>`;
      }
      if (updatedEl) updatedEl.textContent = '快照：—';
    }
  }

  fetchAndRender();
  setInterval(fetchAndRender, REFRESH_MS);
</script>