---
// GlobalMarketsBoard.astro
// 「纵横东西」模块 (v7 — 2026-09-08 18:15 Frank 诉求: 每个行情数据添加时间, 已收盘写收盘时间点)
// 改动 (v6 → v7):
//   1. 每个 .gm-fcard 新增「时间 + 状态」行 (在涨跌徽章下方, 新加一行不替换不并排)
//   2. 时间: item.asOf → HH:MM (Asia/Shanghai)
//   3. 状态: 客户端根据 MARKET_HOURS_BY_CODE 推断
//      - 盘中 → 🟢 圆点 + 「盘中」label
//      - 收盘 → ⚫ 圆点 + 「收盘」+ 收盘时间点 (HH:MM, 如 15:00)
//      - 盘前 → 🟡 圆点 + 「盘前」
//      - 24h (yahoo 国际期货) → 灰点 + 「24h」label
//   4. 零 API 改动: /api/global-markets 已返回 per-item asOf 字段 (verified 18:15)
// 边界: 只动本文件, 不碰 api/global-markets.js
// 教训: scoped CSS 不命中 JS 动态注入的 DOM → 全用 <style is:global> + inline style 兜底
const CATEGORY_ORDER = ['energy', 'precious', 'metals', 'agriculture', 'us_index', 'asia_index', 'cn_index'];
---

<section class="global-markets" aria-label="纵横东西">
  <header class="gm-header">
    <h2 class="gm-title">🌐 纵横东西</h2>
    <p class="gm-sub">大宗期货 · 美股 · 亚太 · 中国指数</p>
    <span class="gm-updated" id="global-markets-updated"></span>
  </header>

  <!-- 重点行情: 方块 grid (4/3/2/1 响应式, 纯展示不可点) -->
  <div class="gm-featured">
    <div class="gm-featured-head">
      <h3 class="gm-featured-title">🔥 重点行情</h3>
      <span class="gm-featured-hint">纯展示 · 不可点击</span>
    </div>
    <div class="gm-featured-grid" id="gm-featured-grid">
      <div class="gm-skeleton">加载中…</div>
    </div>
  </div>

  <!-- 分类 tab + 整个分类 items 方块 grid (v6: 一次显示全部, 不再点击展开) -->
  <div class="gm-cats" id="gm-cats"></div>

  <footer class="gm-footer">
    <span>数据来源: 腾讯财经 · 新浪财经 · Yahoo Finance · 缓存 5 分钟</span>
  </footer>
</section>

<style is:global>
  /* =========================================================
     Global scope: Astro scoped CSS 不命中 JS 动态注入的 DOM
     (Codex 15:11 / Frank 15:25 教训), 所以本组件全部样式用 is:global
     ========================================================= */

  .global-markets {
    --gm-bg: #0f1115;
    --gm-card: #171a21;
    --gm-card-hover: #1d2129;
    --gm-border: #232833;
    --gm-border-strong: #2f3540;
    --gm-text: #f5f7fa;
    --gm-muted: #8b93a1;
    --gm-up: #ff6b6b;
    --gm-up-bg: rgba(255, 107, 107, 0.14);
    --gm-up-faint: rgba(255, 107, 107, 0.06);
    --gm-down: #2dd4a0;
    --gm-down-bg: rgba(45, 212, 160, 0.14);
    --gm-down-faint: rgba(45, 212, 160, 0.06);
    --gm-flat: #6b7280;
    --gm-flat-bg: rgba(107, 114, 128, 0.12);
    --gm-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;

    max-width: 1200px;
    margin: 0 auto var(--space-12);
    padding: var(--space-6) var(--space-4);
    background: var(--gm-bg);
    border: 1px solid var(--gm-border);
    border-radius: 8px;
  }

  /* ===== Header ===== */
  .gm-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--gm-border);
  }
  .gm-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--gm-text);
    letter-spacing: 0.01em;
  }
  .gm-sub {
    margin: 0;
    font-size: 0.78rem;
    color: var(--gm-muted);
  }
  .gm-updated {
    font-family: var(--gm-mono);
    font-size: 0.72rem;
    color: var(--gm-muted);
    margin-left: auto;
  }

  /* ===== Featured (方块 grid) ===== */
  .gm-featured { margin-bottom: var(--space-6); }

  .gm-featured-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .gm-featured-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--gm-text);
    letter-spacing: 0.02em;
  }
  .gm-featured-hint {
    font-family: var(--gm-mono);
    font-size: 0.7rem;
    color: var(--gm-muted);
  }

  .gm-featured-grid,
  .gm-cat-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  /* 响应式断点 (Codex 推荐答案 #2: 桌面 4 / 平板 3 / 手机 2 / 窄屏 1) */
  @media (max-width: 1024px) {
    .gm-featured-grid,
    .gm-cat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .gm-featured-grid,
    .gm-cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 380px) {
    .gm-featured-grid,
    .gm-cat-grid { grid-template-columns: 1fr; }
  }

  /* Featured / Category 方块 (column 布局, 顶部涨跌色条) — 两处共用 */
  .gm-fcard {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    padding: 12px 14px;
    background: var(--gm-card);
    border: 1px solid var(--gm-border);
    border-top: 4px solid var(--gm-flat);
    border-radius: 8px;
    cursor: default;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    min-width: 0;
  }
  .gm-fcard:hover {
    transform: translateY(-1px);
    border-color: var(--gm-border-strong);
    background: var(--gm-card-hover);
  }
  .gm-fcard.up { border-top-color: var(--gm-up); background: linear-gradient(180deg, var(--gm-up-faint), var(--gm-card) 32%); }
  .gm-fcard.down { border-top-color: var(--gm-down); background: linear-gradient(180deg, var(--gm-down-faint), var(--gm-card) 32%); }
  .gm-fcard.flat { border-top-color: var(--gm-flat); }

  .gm-fcard-name {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--gm-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gm-fcard-price {
    font-family: var(--gm-mono);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--gm-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .gm-fcard.up .gm-fcard-price { color: var(--gm-up); }
  .gm-fcard.down .gm-fcard-price { color: var(--gm-down); }
  .gm-fcard.flat .gm-fcard-price { color: var(--gm-text); }

  .gm-fcard-unit {
    font-family: var(--gm-mono);
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--gm-muted);
    margin-left: 4px;
  }

  /* 涨跌徽章 */
  .gm-change {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 8px;
    border-radius: 6px;
    font-family: var(--gm-mono);
    font-size: 0.78rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    width: fit-content;
  }
  .gm-change.up { color: var(--gm-up); background: var(--gm-up-bg); }
  .gm-change.down { color: var(--gm-down); background: var(--gm-down-bg); }
  .gm-change.flat { color: var(--gm-muted); background: var(--gm-flat-bg); }

  /* v7: 行情数据时间 + 状态 (Frank 18:15 诉求) */
  .gm-fcard-time {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--gm-mono);
    font-size: 0.68rem;
    color: var(--gm-muted);
    font-variant-numeric: tabular-nums;
    margin-top: 2px;
    line-height: 1;
  }
  .gm-fcard-time .gm-fcard-time-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .gm-fcard-time.open .gm-fcard-time-dot { background: var(--gm-up); box-shadow: 0 0 0 2px var(--gm-up-faint); }
  .gm-fcard-time.closed .gm-fcard-time-dot { background: var(--gm-flat); }
  .gm-fcard-time.pre .gm-fcard-time-dot { background: #facc15; box-shadow: 0 0 0 2px rgba(250, 204, 21, 0.18); }
  .gm-fcard-time.always .gm-fcard-time-dot { background: var(--gm-muted); }
  .gm-fcard-time.unknown .gm-fcard-time-dot { background: var(--gm-muted); opacity: 0.5; }
  .gm-fcard-time-time { font-weight: 500; }
  .gm-fcard-time-label { opacity: 0.85; }

  /* ===== Category Tabs ===== */
  .gm-cat-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--gm-border);
  }
  .gm-cat-tab {
    padding: 6px 14px;
    border: 1px solid var(--gm-border);
    background: transparent;
    color: var(--gm-muted);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .gm-cat-tab:hover {
    color: var(--gm-text);
    border-color: var(--gm-border-strong);
  }
  .gm-cat-tab.active {
    background: var(--gm-card);
    color: var(--gm-text);
    border-color: var(--gm-text);
  }
  .gm-cat-tab-count {
    font-family: var(--gm-mono);
    font-size: 0.7rem;
    opacity: 0.7;
  }

  /* v6: 当前激活分类的 grid 容器 (用 .gm-cat-grid class, 复用 .gm-featured-grid 样式) */
  .gm-cat-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 10px;
    padding: 0 2px;
  }
  .gm-cat-section-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gm-text);
  }
  .gm-cat-section-count {
    font-family: var(--gm-mono);
    font-size: 0.72rem;
    color: var(--gm-muted);
  }

  /* ===== Common ===== */
  .gm-skeleton {
    grid-column: 1 / -1;
    padding: var(--space-8) 0;
    text-align: center;
    color: var(--gm-muted);
    font-size: 0.85rem;
  }
  .gm-error {
    padding: var(--space-4);
    background: rgba(240, 85, 77, 0.08);
    border: 1px solid rgba(240, 85, 77, 0.35);
    border-radius: 4px;
    color: #fca5a5;
    font-size: 0.85rem;
    text-align: center;
  }
  .gm-footer {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--gm-border);
    font-family: var(--gm-mono);
    font-size: 0.7rem;
    color: var(--gm-muted);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .gm-fcard, .gm-cat-tab { transition: none; }
    .gm-fcard:hover { transform: none; }
  }
</style>

<script>
  const featuredGrid = document.getElementById('gm-featured-grid');
  const catsEl = document.getElementById('gm-cats');
  const updatedEl = document.getElementById('global-markets-updated');
  const REFRESH_MS = 5 * 60 * 1000;

  const CATEGORY_ORDER = ['energy', 'precious', 'metals', 'agriculture', 'us_index', 'asia_index', 'cn_index'];

  const CATEGORY_LABELS = {
    energy: '能源',
    precious: '贵金属',
    metals: '有色金属',
    agriculture: '农产品',
    us_index: '美股指数',
    asia_index: '亚太指数',
    cn_index: '中国指数',
  };

  const DEFAULT_CAT = 'energy';

  // Mutable state
  let currentPayload = null;
  let activeCat = DEFAULT_CAT;

  // ── Helpers ────────────────────────────────────────────────────

  function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, ch => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[ch] || ch));
  }

  function dirOf(p) {
    if (p == null || isNaN(p) || p === 0) return 'flat';
    return p > 0 ? 'up' : 'down';
  }

  function fmtPrice(p) {
    if (p == null || isNaN(p)) return '—';
    if (p >= 10000) return p.toLocaleString('en-US', { maximumFractionDigits: 0 });
    if (p >= 100) return p.toFixed(2);
    if (p >= 10) return p.toFixed(3);
    return p.toFixed(4);
  }

  function fmtChangePct(p) {
    if (p == null || isNaN(p)) return null;
    return (p >= 0 ? '+' : '') + p.toFixed(2) + '%';
  }

  function changeHtml(change) {
    const text = fmtChangePct(change);
    if (text == null) return `<span class="gm-change flat">—</span>`;
    const dir = dirOf(change);
    const arrow = dir === 'up' ? '↑' : dir === 'down' ? '↓' : '—';
    return `<span class="gm-change ${dir}">${arrow} ${escapeHtml(text)}</span>`;
  }

  // v7: 时段表 (Asia/Shanghai 时区)
  // code 精确匹配: 10 个指数代码 (沪深 3 + 美股 3 + 港股 1 + 亚太 3)
  // 期货: 按 src 分类 (sina nf_* 国内期货 / yahoo 国际期货 24h)
  const MARKET_HOURS_BY_CODE = {
    // 沪深指数 (A 股)
    'sh000001': { open: '09:30', close: '15:00' },
    'sz399001': { open: '09:30', close: '15:00' },
    'sz399673': { open: '09:30', close: '15:00' },
    // 港股
    'hkHSI': { open: '09:30', close: '16:00' },
    // 美股 (北京时间, 夏令时近似)
    'usINX': { open: '21:30', close: '04:00', nextDay: true },
    'usIXIC': { open: '21:30', close: '04:00', nextDay: true },
    'usDJI': { open: '21:30', close: '04:00', nextDay: true },
    // 亚太指数 (Yahoo) - 各自本地时段转 Asia/Shanghai 简化
    '^N225': { open: '08:00', close: '14:00' },  // 日经
    '^KS11': { open: '08:00', close: '15:30' },  // 韩国 KOSPI
    '^TWII': { open: '08:00', close: '13:30' },  // 台湾加权
  };

  // v7: 工具函数 - 时分转分钟数
  function hhmmToMinutes(s) {
    if (!s) return 0;
    const [h, m] = s.split(':').map(Number);
    return (h || 0) * 60 + (m || 0);
  }

  // v7: 工具函数 - 当前 Asia/Shanghai 分钟数
  function nowInShanghaiMinutes() {
    try {
      const fmt = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Shanghai',
        hour12: false,
        hour: '2-digit',
        minute: '2-digit',
      });
      const parts = fmt.formatToParts(new Date());
      const h = parseInt(parts.find(p => p.type === 'hour').value, 10);
      const m = parseInt(parts.find(p => p.type === 'minute').value, 10);
      return h * 60 + m;
    } catch (e) {
      const d = new Date();
      return d.getHours() * 60 + d.getMinutes();
    }
  }

  // v7: 工具函数 - 格式化 asOf 为 HH:MM
  function fmtTime(asOf) {
    if (asOf == null || typeof asOf !== 'number' || isNaN(asOf) || asOf <= 0) return '--';
    try {
      const fmt = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Shanghai',
        hour12: false,
        hour: '2-digit',
        minute: '2-digit',
      });
      return fmt.format(new Date(asOf));
    } catch (e) {
      const d = new Date(asOf);
      const h = String(d.getHours()).padStart(2, '0');
      const m = String(d.getMinutes()).padStart(2, '0');
      return `${h}:${m}`;
    }
  }

  // v7: 推断市场状态 (open/closed/pre/always/unknown)
  // 核心规则:
  //   - yahoo 国际期货 (=F 后缀) → 24h always
  //   - sina nf_* (国内期货) → 日盘 09:00-15:00 + 夜盘 21:00-02:30 (次日)
  //   - 其他指数 → MARKET_HOURS_BY_CODE 匹配
  function getMarketState(item) {
    if (!item) return { state: 'unknown', label: '—', time: '--' };

    // yahoo 国际期货 (CL=F, GC=F, SI=F 等)
    if (item.source === 'yahoo' && /=[A-Z]$/.test(item.code || '')) {
      return { state: 'always', label: '24h', time: fmtTime(item.asOf) };
    }

    // sina 国内期货 (nf_*)
    if (item.code && /^nf_/i.test(item.code)) {
      const now = nowInShanghaiMinutes();
      const dayOpen = hhmmToMinutes('09:00');
      const dayClose = hhmmToMinutes('15:00');
      const nightOpen = hhmmToMinutes('21:00');
      const nightEnd = hhmmToMinutes('02:30'); // 次日凌晨
      const inDay = now >= dayOpen && now < dayClose;
      const inNight = now >= nightOpen || now < nightEnd;
      const time = fmtTime(item.asOf);
      if (inDay) return { state: 'open', label: '日盘', time };
      if (inNight) return { state: 'open', label: '夜盘', time };
      // 收盘 → 显示 15:00 (日盘收盘) 作为 Frank 诉求的「收盘时间点」
      return { state: 'closed', label: '收盘', time: '15:00' };
    }

    // 指数 → 用 code 匹配时段表
    if (item.code && MARKET_HOURS_BY_CODE[item.code]) {
      return computeStateFromHours(MARKET_HOURS_BY_CODE[item.code], item);
    }

    // 兜底: 只显示时间, 状态 unknown
    return { state: 'unknown', label: '—', time: fmtTime(item.asOf) };
  }

  function computeStateFromHours(mh, item) {
    const now = nowInShanghaiMinutes();
    const openM = hhmmToMinutes(mh.open);
    let closeM = hhmmToMinutes(mh.close);
    if (mh.nextDay) closeM += 24 * 60;
    // 盘前窗口: 开盘前 30 分钟
    const preOpenStart = Math.max(0, openM - 30);

    let inSession;
    if (mh.nextDay) {
      // 跨日: 例如 21:30 - 次日 04:00
      inSession = now >= openM || now < (closeM - 24 * 60);
    } else {
      inSession = now >= openM && now < closeM;
    }
    const inPre = !inSession && now >= preOpenStart && now < openM;

    const time = fmtTime(item.asOf);
    if (inSession) return { state: 'open', label: '盘中', time };
    if (inPre) return { state: 'pre', label: '盘前', time: mh.open };
    // 收盘 → 显示收盘时间点 (Frank 18:15 核心诉求)
    return { state: 'closed', label: '收盘', time: mh.close };
  }

  // v7: 渲染时间徽章 HTML
  function timeBadgeHtml(item) {
    const ms = getMarketState(item);
    return `<div class="gm-fcard-time ${ms.state}">
      <span class="gm-fcard-time-dot" aria-hidden="true"></span>
      <span class="gm-fcard-time-time">${escapeHtml(ms.time)}</span>
      <span class="gm-fcard-time-label">${escapeHtml(ms.label)}</span>
    </div>`;
  }

  function cardHtml(it) {
    // v7: 重点行情 + 分类 items 共用 .gm-fcard 模板
    const dir = dirOf(it.changePct);
    const priceTxt = it.price != null ? fmtPrice(it.price) : '—';
    return `<div class="gm-fcard ${dir}" data-code="${escapeHtml(it.code)}" data-cat="${escapeHtml(it.category || '')}">
      <div class="gm-fcard-name">${escapeHtml(it.nameZh || it.code)}</div>
      <div class="gm-fcard-price">${priceTxt}<span class="gm-fcard-unit">${escapeHtml(it.unit || '')}</span></div>
      ${changeHtml(it.changePct)}
      ${timeBadgeHtml(it)}
    </div>`;
  }

  // ── Render: Featured (方块 grid, 纯展示不可点) ────────────────

  function renderFeatured(items) {
    if (!featuredGrid) return;
    if (!items.length) {
      featuredGrid.innerHTML = '<div class="gm-skeleton">暂无重点行情数据</div>';
      return;
    }
    featuredGrid.innerHTML = items.map(cardHtml).join('');
  }

  // ── Render: Cats container (tabs + active section) ─────────────

  function renderCatsContainer() {
    if (!catsEl) return;
    catsEl.innerHTML = `
      <div class="gm-cat-tabs" id="gm-cat-tabs"></div>
      <div class="gm-cat-section-head" id="gm-cat-section-head"></div>
      <div class="gm-cat-grid" id="gm-cat-grid"></div>
    `;
    renderCategoryTabs();
    renderActiveSection();
  }

  function renderCategoryTabs() {
    const tabsEl = document.getElementById('gm-cat-tabs');
    if (!tabsEl || !currentPayload) return;
    const cats = currentPayload.categories || {};
    const html = CATEGORY_ORDER
      .map(k => {
        const cat = cats[k];
        if (!cat || !cat.items || !cat.items.length) return '';
        const label = cat.label || CATEGORY_LABELS[k] || k;
        const isActive = k === activeCat;
        return `<button type="button" class="gm-cat-tab${isActive ? ' active' : ''}" data-cat="${k}">${escapeHtml(label)}<span class="gm-cat-tab-count">${cat.items.length}</span></button>`;
      })
      .filter(Boolean)
      .join('');
    tabsEl.innerHTML = html;

    tabsEl.querySelectorAll('.gm-cat-tab').forEach(tab => {
      tab.addEventListener('click', () => switchCategory(tab.dataset.cat));
    });
  }

  function renderActiveSection() {
    const headEl = document.getElementById('gm-cat-section-head');
    const gridEl = document.getElementById('gm-cat-grid');
    if (!headEl || !gridEl || !currentPayload) return;
    const cats = currentPayload.categories || {};
    const cat = cats[activeCat];
    if (!cat || !cat.items || !cat.items.length) {
      headEl.innerHTML = '';
      gridEl.innerHTML = '<div class="gm-skeleton">该分类暂无数据</div>';
      return;
    }
    const label = cat.label || CATEGORY_LABELS[activeCat] || activeCat;
    headEl.innerHTML = `
      <div class="gm-cat-section-title">${escapeHtml(label)}</div>
      <div class="gm-cat-section-count">${cat.items.length} 项</div>
    `;
    // v6: 整个分类的 items 直接用方块 grid 渲染 (复用 .gm-fcard 模板)
    gridEl.innerHTML = cat.items.map(it => {
      // 标记 category 给 cardHtml (用于 dataset 追踪, 不影响视觉)
      if (!it.category) it.category = activeCat;
      return cardHtml(it);
    }).join('');
  }

  function switchCategory(cat) {
    if (!cat || cat === activeCat) return;
    activeCat = cat;

    // Update tab active state
    document.querySelectorAll('.gm-cat-tab').forEach(tab => {
      tab.classList.toggle('active', tab.dataset.cat === cat);
    });

    renderActiveSection();
  }

  // ── Render: top-level dispatch ──────────────────────────────────

  function render(payload) {
    currentPayload = payload;
    const cats = payload.categories || {};
    const featured = [];
    for (const cat of Object.values(cats)) {
      for (const it of (cat.items || [])) {
        if (it.featured) featured.push(it);
      }
    }

    renderFeatured(featured);

    if (catsEl) {
      if (!Object.keys(cats).length) {
        catsEl.innerHTML = '<div class="gm-error">暂无更多行情</div>';
      } else {
        renderCatsContainer();
      }
    }

    if (updatedEl) {
      const t = new Date(payload.asOf || Date.now());
      updatedEl.textContent = '快照 ' + t.toLocaleString('zh-CN', { hour12: false, timeZone: 'Asia/Shanghai' });
    }
  }

  async function fetchAndRender() {
    try {
      const r = await fetch('/api/global-markets', { cache: 'no-store' });
      if (!r.ok) throw new Error('http ' + r.status);
      render(await r.json());
    } catch (err) {
      if (featuredGrid) {
        featuredGrid.innerHTML = `<div class="gm-error">行情获取失败: ${escapeHtml(String(err && err.message || err))}</div>`;
      }
      if (updatedEl) updatedEl.textContent = '快照: —';
    }
  }

  fetchAndRender();
  setInterval(fetchAndRender, REFRESH_MS);
</script>
