---
// GlobalMarketsBoard.astro
// 「纵横东西」模块：重点行情（9 项置顶）+ 其余分类折叠
// 数据来源: /api/global-markets (Vercel serverless，多源 + 5min 缓存)
// Frank 2026-09-07 19:25 反馈：布局优化 + 重点 9 项 + 其余折叠
const CATEGORY_ORDER = ['energy', 'precious', 'metals', 'agriculture', 'us_index', 'asia_index', 'cn_index'];
---

<section class="global-markets" aria-label="纵横东西">
  <header class="gm-header">
    <h2 class="gm-title">🌐 纵横东西</h2>
    <p class="gm-sub">大宗期货 · 美股 · 亚太 · 中国指数</p>
  </header>

  <!-- 重点行情：9 项永远可见，大字卡片 -->
  <div class="gm-featured">
    <div class="gm-featured-head">
      <h3 class="gm-featured-title">🔥 重点行情</h3>
      <span class="gm-updated" id="global-markets-updated"></span>
    </div>
    <div class="gm-featured-grid" id="gm-featured-grid">
      <div class="gm-skeleton">正在拉取全球行情…</div>
    </div>
  </div>

  <!-- 其余行情：默认折叠 -->
  <div class="gm-cats" id="gm-cats"></div>

  <footer class="gm-footer">
    <span class="gm-source">数据来源：腾讯财经 · 新浪财经 · Yahoo Finance</span>
  </footer>
</section>

<style>
  .global-markets {
    max-width: 1200px;
    margin: 0 auto var(--space-12);
    padding: var(--space-6) var(--space-4);
    background: var(--color-bg-elevated, #14171f);
    border-radius: 12px;
    border: 1px solid var(--color-border, #2a2f3a);
  }

  .gm-header { margin-bottom: var(--space-5); }

  .gm-title {
    font-size: var(--font-size-xl, 1.5rem);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text, #e5e7eb);
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .gm-sub {
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, #9ca3af);
    margin: var(--space-1) 0 0;
  }

  /* ── 重点行情 ── */
  .gm-featured { margin-bottom: var(--space-4); }

  .gm-featured-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .gm-featured-title {
    margin: 0;
    font-size: var(--font-size-lg, 1.125rem);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text, #e5e7eb);
  }

  .gm-updated {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted, #9ca3af);
  }

  .gm-featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (max-width: 1024px) {
    .gm-featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .gm-featured-grid { grid-template-columns: 1fr; }
  }

  .gm-skeleton {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-10) 0;
    color: var(--color-text-muted, #9ca3af);
    font-size: var(--font-size-sm, 0.875rem);
  }

  .gm-fcard {
    background: var(--color-bg, #0f1117);
    border: 1px solid var(--color-border, #2a2f3a);
    border-radius: 10px;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .gm-fcard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-width: 0;
  }

  .gm-fcard-name {
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, #9ca3af);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gm-fcard-unit {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted, #9ca3af);
    flex-shrink: 0;
  }

  .gm-fcard-price {
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text, #e5e7eb);
    font-variant-numeric: tabular-nums;
  }

  .gm-change {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: var(--font-weight-medium, 500);
  }

  .gm-change.up { color: #ef4444; }   /* A 股惯例：红涨 */
  .gm-change.down { color: #22c55e; } /* 绿跌 */
  .gm-change.flat { color: var(--color-text-muted, #9ca3af); }

  .gm-arrow { font-size: 0.75em; }

  /* ── 其余行情（折叠分类）── */
  .gm-cats {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  details.gm-cat {
    background: var(--color-bg, #0f1117);
    border: 1px solid var(--color-border, #2a2f3a);
    border-radius: 8px;
    overflow: hidden;
  }

  summary.gm-cat-label {
    cursor: pointer;
    list-style: none;
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-base, 1rem);
    font-weight: var(--font-weight-medium, 500);
    color: var(--color-text, #e5e7eb);
    background: var(--color-bg-elevated, #14171f);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    user-select: none;
  }

  summary.gm-cat-label::-webkit-details-marker { display: none; }

  summary.gm-cat-label::before {
    content: '▸';
    transition: transform 150ms ease;
    color: var(--color-text-muted, #9ca3af);
  }

  details[open] summary.gm-cat-label::before { transform: rotate(90deg); }

  .gm-cat-count {
    margin-left: auto;
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted, #9ca3af);
    font-weight: normal;
  }

  .gm-cat-bar { height: 3px; width: 100%; }

  .gm-cat-bar-energy      { background: #f97316; }
  .gm-cat-bar-precious    { background: #eab308; }
  .gm-cat-bar-metals      { background: #6366f1; }
  .gm-cat-bar-agriculture { background: #84cc16; }
  .gm-cat-bar-us_index    { background: #3b82f6; }
  .gm-cat-bar-asia_index  { background: #ec4899; }
  .gm-cat-bar-cn_index    { background: #ef4444; }

  .gm-cat-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    padding: var(--space-2) var(--space-4);
  }

  @media (max-width: 640px) {
    .gm-cat-items { grid-template-columns: 1fr; }
  }

  .gm-item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border, #2a2f3a);
  }

  .gm-item-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .gm-item-name-zh {
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text, #e5e7eb);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gm-item-unit {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted, #9ca3af);
  }

  .gm-item-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    font-variant-numeric: tabular-nums;
  }

  .gm-item-price-value {
    font-size: var(--font-size-base, 1rem);
    font-weight: var(--font-weight-medium, 500);
    color: var(--color-text, #e5e7eb);
  }

  .gm-item-empty { color: var(--color-text-muted, #9ca3af); font-style: italic; }

  .gm-footer {
    margin-top: var(--space-4);
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted, #9ca3af);
  }

  .gm-error {
    grid-column: 1 / -1;
    padding: var(--space-4);
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 6px;
    color: #fca5a5;
    font-size: var(--font-size-sm, 0.875rem);
    text-align: center;
  }
</style>

<script>
  const featuredGrid = document.getElementById('gm-featured-grid');
  const catsEl = document.getElementById('gm-cats');
  const updatedEl = document.getElementById('global-markets-updated');
  const REFRESH_MS = 5 * 60 * 1000;

  const CATEGORY_ORDER = ['energy', 'precious', 'metals', 'agriculture', 'us_index', 'asia_index', 'cn_index'];

  const BAR_CLASS = {
    energy: 'gm-cat-bar-energy',
    precious: 'gm-cat-bar-precious',
    metals: 'gm-cat-bar-metals',
    agriculture: 'gm-cat-bar-agriculture',
    us_index: 'gm-cat-bar-us_index',
    asia_index: 'gm-cat-bar-asia_index',
    cn_index: 'gm-cat-bar-cn_index',
  };

  const CATEGORY_LABELS = {
    energy: '⚡ 能源',
    precious: '🥇 贵金属',
    metals: '🔩 有色金属',
    agriculture: '🌾 农产品',
    us_index: '🇺🇸 美股指数',
    asia_index: '🌏 亚太指数',
    cn_index: '🇨🇳 中国指数',
  };

  function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, ch => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[ch] || ch));
  }

  function fmtPrice(p) {
    if (p == null || isNaN(p)) return '—';
    if (p >= 10000) return p.toLocaleString('en-US', { maximumFractionDigits: 0 });
    if (p >= 100) return p.toFixed(2);
    if (p >= 10) return p.toFixed(3);
    return p.toFixed(4);
  }

  function fmtChangePct(p) {
    if (p == null || isNaN(p)) return null;
    return (p >= 0 ? '+' : '') + p.toFixed(2) + '%';
  }

  function changeHtml(change) {
    const text = fmtChangePct(change);
    if (text == null) return `<span class="gm-change flat">—</span>`;
    let cls = 'flat';
    let arrow = '—';
    if (change > 0) { cls = 'up'; arrow = '▲'; }
    else if (change < 0) { cls = 'down'; arrow = '▼'; }
    return `<span class="gm-change ${cls}"><span class="gm-arrow">${arrow}</span>${escapeHtml(text)}</span>`;
  }

  function renderFeatured(items) {
    if (!featuredGrid) return;
    if (!items.length) {
      featuredGrid.innerHTML = '<div class="gm-skeleton">暂无数据</div>';
      return;
    }
    featuredGrid.innerHTML = items.map(it => {
      const priceHtml = it.price != null
        ? `<span class="gm-fcard-price">${fmtPrice(it.price)}</span>`
        : `<span class="gm-fcard-price gm-item-empty">暂无</span>`;
      return `<div class="gm-fcard">
        <div class="gm-fcard-top">
          <span class="gm-fcard-name">${escapeHtml(it.nameZh || it.code)}</span>
          <span class="gm-fcard-unit">${escapeHtml(it.unit || '')}</span>
        </div>
        ${priceHtml}
        ${changeHtml(it.changePct)}
      </div>`;
    }).join('');
  }

  function renderCategory(catKey, catData) {
    const items = (catData.items || []).filter(it => !it.featured);
    if (!items.length) return '';
    const barClass = BAR_CLASS[catKey] || '';
    const label = catData.label || CATEGORY_LABELS[catKey] || catKey;
    const itemsHtml = items.map(it => {
      const priceHtml = it.price != null
        ? `<span class="gm-item-price-value">${fmtPrice(it.price)}</span>`
        : `<span class="gm-item-price-value gm-item-empty">暂无</span>`;
      return `<div class="gm-item">
        <div class="gm-item-name">
          <span class="gm-item-name-zh">${escapeHtml(it.nameZh || it.code)}</span>
          <span class="gm-item-unit">${escapeHtml(it.unit || '')}</span>
        </div>
        <div class="gm-item-price">
          ${priceHtml}
          ${changeHtml(it.changePct)}
        </div>
      </div>`;
    }).join('');
    return `<details class="gm-cat">
      <div class="gm-cat-bar ${barClass}"></div>
      <summary class="gm-cat-label">${escapeHtml(label)}<span class="gm-cat-count">${items.length} 项</span></summary>
      <div class="gm-cat-items">${itemsHtml}</div>
    </details>`;
  }

  function render(payload) {
    const cats = payload.categories || {};
    const featured = [];
    for (const cat of Object.values(cats)) {
      for (const it of (cat.items || [])) {
        if (it.featured) featured.push(it);
      }
    }
    renderFeatured(featured);

    if (catsEl) {
      const html = CATEGORY_ORDER.map(k => cats[k] ? renderCategory(k, cats[k]) : '').join('');
      catsEl.innerHTML = html || '<div class="gm-error">暂无更多行情</div>';
    }

    if (updatedEl) {
      const t = new Date(payload.asOf || Date.now());
      updatedEl.textContent = '快照 ' + t.toLocaleString('zh-CN', { hour12: false, timeZone: 'Asia/Shanghai' });
    }
  }

  async function fetchAndRender() {
    try {
      const r = await fetch('/api/global-markets', { cache: 'no-store' });
      if (!r.ok) throw new Error('http ' + r.status);
      render(await r.json());
    } catch (err) {
      if (featuredGrid) {
        featuredGrid.innerHTML = `<div class="gm-error">⚠️ 实时行情获取失败（${escapeHtml(String(err && err.message || err))}）。请稍后重试。</div>`;
      }
      if (updatedEl) updatedEl.textContent = '快照：—';
    }
  }

  fetchAndRender();
  setInterval(fetchAndRender, REFRESH_MS);
</script>
