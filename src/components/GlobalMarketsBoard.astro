---
// GlobalMarketsBoard.astro
// 「纵横东西」模块：重点行情（9 项置顶）+ 其余分类折叠
// 数据来源: /api/global-markets (Vercel serverless，多源 + 5min 缓存)
// 风格: Bloomberg Terminal 专业终端风 — 深色 + monospace 等宽数字 + 高密度 + 涨跌左侧色条
// rebuild-trigger: 2026-09-07 21:40
const CATEGORY_ORDER = ['energy', 'precious', 'metals', 'agriculture', 'us_index', 'asia_index', 'cn_index'];
---

<section class="global-markets" aria-label="纵横东西">
  <header class="gm-header">
    <h2 class="gm-title">纵横东西</h2>
    <p class="gm-sub">大宗期货 · 美股 · 亚太 · 中国指数</p>
  </header>

  <div class="gm-featured">
    <div class="gm-featured-head">
      <h3 class="gm-featured-title">重点行情</h3>
      <span class="gm-updated" id="global-markets-updated"></span>
    </div>
    <div class="gm-featured-grid" id="gm-featured-grid">
      <div class="gm-skeleton">加载中…</div>
    </div>
  </div>

  <div class="gm-cats" id="gm-cats"></div>

  <footer class="gm-footer">
    <span>数据来源：腾讯财经 · 新浪财经 · Yahoo Finance</span>
  </footer>
</section>

<style is:global>
  .global-markets {
    --gm-bg: #0f1115;
    --gm-card: #171a21;
    --gm-border: #232833;
    --gm-text: #f5f7fa;
    --gm-muted: #8b93a1;
    --gm-up: #ff6b6b;
    --gm-down: #2dd4a0;
    --gm-flat: #6b7280;
    --gm-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;

    max-width: 1200px;
    margin: 0 auto var(--space-12);
    padding: var(--space-6) var(--space-4);
    background: var(--gm-bg);
    border: 1px solid var(--gm-border);
    border-radius: 8px;
  }

  .gm-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--gm-border);
  }

  .gm-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--gm-text);
  }

  .gm-sub {
    margin: 0;
    font-size: 0.78rem;
    color: var(--gm-muted);
  }

  /* 重点行情 */
  .gm-featured { margin-bottom: var(--space-4); }

  .gm-featured-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .gm-featured-title {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gm-muted);
  }

  .gm-updated {
    font-family: var(--gm-mono);
    font-size: 0.72rem;
    color: var(--gm-muted);
  }

  .gm-featured-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .gm-skeleton {
    grid-column: 1 / -1;
    padding: var(--space-10) 0;
    text-align: center;
    color: var(--gm-muted);
    font-size: 0.8rem;
  }

  .gm-fcard {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 14px;
    background: var(--gm-card);
    border: 1px solid var(--gm-border);
    border-left: 4px solid var(--gm-flat);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    min-width: 0;
  }

  .gm-fcard.up { border-left-color: var(--gm-up); background: linear-gradient(90deg, rgba(255,107,107,0.10), var(--gm-card) 48%); }
  .gm-fcard.down { border-left-color: var(--gm-down); background: linear-gradient(90deg, rgba(45,212,160,0.10), var(--gm-card) 48%); }
  .gm-fcard.flat { border-left-color: var(--gm-flat); }

  .gm-fcard-name {
    flex: 1;
    min-width: 0;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--gm-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gm-fcard-price {
    flex-shrink: 0;
    font-family: var(--gm-mono);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--gm-text);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .gm-fcard.up .gm-fcard-price { color: var(--gm-up); }
  .gm-fcard.down .gm-fcard-price { color: var(--gm-down); }
  .gm-fcard.flat .gm-fcard-price { color: var(--gm-text); }

  .gm-fcard-unit {
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--gm-muted);
  }

  .gm-change {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 8px;
    border-radius: 6px;
    font-family: var(--gm-mono);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .gm-change.up { color: var(--gm-up); background: rgba(255,107,107,0.14); }
  .gm-change.down { color: var(--gm-down); background: rgba(45,212,160,0.14); }
  .gm-change.flat { color: var(--gm-muted); background: rgba(107,114,128,0.12); }

  /* 折叠分类 */
  .gm-cats {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  details.gm-cat {
    background: var(--gm-card);
    border: 1px solid var(--gm-border);
    border-radius: 4px;
    overflow: hidden;
  }

  summary.gm-cat-label {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--gm-text);
    user-select: none;
  }

  summary.gm-cat-label::-webkit-details-marker { display: none; }

  summary.gm-cat-label::before {
    content: '+';
    font-family: var(--gm-mono);
    color: var(--gm-muted);
    width: 12px;
  }

  details[open] summary.gm-cat-label::before { content: '−'; }

  .gm-cat-count {
    margin-left: auto;
    font-family: var(--gm-mono);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--gm-muted);
  }

  .gm-cat-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 12px;
    padding: 4px 12px 8px;
  }

  @media (max-width: 640px) {
    .gm-cat-items { grid-template-columns: 1fr; }
  }

  .gm-item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 5px 0;
    border-bottom: 1px solid var(--gm-border);
  }

  .gm-item-name {
    font-size: 0.8rem;
    color: var(--gm-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gm-item-unit {
    font-size: 0.68rem;
    color: var(--gm-muted);
  }

  .gm-item-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-variant-numeric: tabular-nums;
  }

  .gm-item-price-value {
    font-family: var(--gm-mono);
    font-size: 0.85rem;
    color: var(--gm-text);
  }

  .gm-item-empty { color: var(--gm-muted); font-style: italic; }

  .gm-footer {
    margin-top: var(--space-3);
    font-family: var(--gm-mono);
    font-size: 0.7rem;
    color: var(--gm-muted);
  }

  .gm-error {
    grid-column: 1 / -1;
    padding: var(--space-4);
    background: rgba(240, 85, 77, 0.08);
    border: 1px solid rgba(240, 85, 77, 0.35);
    border-radius: 4px;
    color: #fca5a5;
    font-size: 0.8rem;
    text-align: center;
  }
</style>

<script>
  const featuredGrid = document.getElementById('gm-featured-grid');
  const catsEl = document.getElementById('gm-cats');
  const updatedEl = document.getElementById('global-markets-updated');
  const REFRESH_MS = 5 * 60 * 1000;

  const CATEGORY_ORDER = ['energy', 'precious', 'metals', 'agriculture', 'us_index', 'asia_index', 'cn_index'];

  const CATEGORY_LABELS = {
    energy: '能源',
    precious: '贵金属',
    metals: '有色金属',
    agriculture: '农产品',
    us_index: '美股指数',
    asia_index: '亚太指数',
    cn_index: '中国指数',
  };

  function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, ch => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[ch] || ch));
  }

  function dirOf(p) {
    if (p == null || isNaN(p) || p === 0) return 'flat';
    return p > 0 ? 'up' : 'down';
  }

  function fmtPrice(p) {
    if (p == null || isNaN(p)) return '—';
    if (p >= 10000) return p.toLocaleString('en-US', { maximumFractionDigits: 0 });
    if (p >= 100) return p.toFixed(2);
    if (p >= 10) return p.toFixed(3);
    return p.toFixed(4);
  }

  function fmtChangePct(p) {
    if (p == null || isNaN(p)) return null;
    return (p >= 0 ? '+' : '') + p.toFixed(2) + '%';
  }

  function changeHtml(change) {
    const text = fmtChangePct(change);
    if (text == null) return `<span class="gm-change flat">—</span>`;
    const dir = dirOf(change);
    const arrow = dir === 'up' ? '↑' : dir === 'down' ? '↓' : '—';
    return `<span class="gm-change ${dir}">${arrow} ${escapeHtml(text)}</span>`;
  }

  function renderFeatured(items) {
    if (!featuredGrid) return;
    if (!items.length) {
      featuredGrid.innerHTML = '<div class="gm-skeleton">暂无数据</div>';
      return;
    }
    featuredGrid.innerHTML = items.map(it => {
      const dir = dirOf(it.changePct);
      const priceHtml = it.price != null
        ? `<span class="gm-fcard-price">${fmtPrice(it.price)} <span class="gm-fcard-unit">${escapeHtml(it.unit || '')}</span></span>`
        : `<span class="gm-fcard-price gm-item-empty">—</span>`;
      return `<div class="gm-fcard ${dir}">
        <span class="gm-fcard-name">${escapeHtml(it.nameZh || it.code)}</span>
        ${priceHtml}
        ${changeHtml(it.changePct)}
      </div>`;
    }).join('');
  }

  function renderCategory(catKey, catData) {
    const items = (catData.items || []).filter(it => !it.featured);
    if (!items.length) return '';
    const label = catData.label || CATEGORY_LABELS[catKey] || catKey;
    const itemsHtml = items.map(it => {
      const priceHtml = it.price != null
        ? `<span class="gm-item-price-value">${fmtPrice(it.price)}</span>`
        : `<span class="gm-item-price-value gm-item-empty">—</span>`;
      return `<div class="gm-item">
        <span class="gm-item-name">${escapeHtml(it.nameZh || it.code)} <span class="gm-item-unit">${escapeHtml(it.unit || '')}</span></span>
        <span class="gm-item-price">${priceHtml}${changeHtml(it.changePct)}</span>
      </div>`;
    }).join('');
    return `<details class="gm-cat">
      <summary class="gm-cat-label">${escapeHtml(label)}<span class="gm-cat-count">${items.length}</span></summary>
      <div class="gm-cat-items">${itemsHtml}</div>
    </details>`;
  }

  function render(payload) {
    const cats = payload.categories || {};
    const featured = [];
    for (const cat of Object.values(cats)) {
      for (const it of (cat.items || [])) {
        if (it.featured) featured.push(it);
      }
    }
    renderFeatured(featured);

    if (catsEl) {
      const html = CATEGORY_ORDER.map(k => cats[k] ? renderCategory(k, cats[k]) : '').join('');
      catsEl.innerHTML = html || '<div class="gm-error">暂无更多行情</div>';
    }

    if (updatedEl) {
      const t = new Date(payload.asOf || Date.now());
      updatedEl.textContent = t.toLocaleString('zh-CN', { hour12: false, timeZone: 'Asia/Shanghai' });
    }
  }

  async function fetchAndRender() {
    try {
      const r = await fetch('/api/global-markets', { cache: 'no-store' });
      if (!r.ok) throw new Error('http ' + r.status);
      render(await r.json());
    } catch (err) {
      if (featuredGrid) {
        featuredGrid.innerHTML = `<div class="gm-error">行情获取失败：${escapeHtml(String(err && err.message || err))}</div>`;
      }
      if (updatedEl) updatedEl.textContent = '—';
    }
  }

  fetchAndRender();
  setInterval(fetchAndRender, REFRESH_MS);
</script>
