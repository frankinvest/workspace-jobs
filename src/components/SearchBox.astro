---
interface Props {
  articleCount: number;
}

const { articleCount } = Astro.props;
---

<div class="search-box-wrap" data-search-box>
  <div class="search-input-row">
    <svg
      class="search-icon"
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="search"
      class="search-input"
      placeholder={`输入关键词, 按 Enter 或点击搜索 (${articleCount} 篇财经早餐)`}
      aria-label="搜索文章"
      aria-describedby="search-hint"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results-list"
      autocomplete="off"
      data-search-input
    />
    <button
      type="button"
      class="search-btn"
      data-search-btn
      aria-label="执行搜索"
    >
      搜索
    </button>
  </div>
  <span id="search-hint" class="search-hint" aria-hidden="true">按 Enter 搜索 · Esc 关闭</span>

  <div
    class="search-results"
    role="listbox"
    id="search-results-list"
    aria-label="搜索结果"
    data-search-results
    hidden
  >
    <div class="search-count" data-search-count aria-live="polite"></div>
    <div class="search-empty" data-search-empty role="status" hidden>
      没找到匹配的文章, 试试别的关键词
    </div>
    <ul class="search-list" data-search-list></ul>
  </div>
</div>

<script>
  import type { Article, SearchResult } from '../utils/search';
  import { escapeHtml, MAX_QUERY_LENGTH, searchArticles } from '../utils/search';

  const box = document.querySelector('[data-search-box]') as HTMLElement | null;
  const input = document.querySelector('[data-search-input]') as HTMLInputElement | null;
  const btn = document.querySelector('[data-search-btn]') as HTMLButtonElement | null;
  const results = document.querySelector('[data-search-results]') as HTMLElement | null;
  const list = document.querySelector('[data-search-list]') as HTMLUListElement | null;
  const empty = document.querySelector('[data-search-empty]') as HTMLElement | null;
  const count = document.querySelector('[data-search-count]') as HTMLElement | null;

  const MAX_RESULTS = 20;
  let searchIndex: Promise<Article[]> | undefined;
  // Closing the panel or submitting again invalidates the previous render.
  let searchRequest = 0;

  function loadSearchIndex(): Promise<Article[]> {
    searchIndex ??= fetch('/search-index.json')
      .then(async (response) => {
        if (!response.ok) throw new Error(`Search index HTTP ${response.status}`);
        const articles: unknown = await response.json();
        if (!Array.isArray(articles)) throw new Error('Invalid search index');
        return articles as Article[];
      })
      .catch((error) => {
        searchIndex = undefined;
        throw error;
      });
    return searchIndex;
  }

  function showMessage(message: string): void {
    if (!list || !count || !empty) return;
    list.replaceChildren();
    count.textContent = '';
    empty.hidden = false;
    empty.textContent = message;
  }

  function setResultsOpen(open: boolean): void {
    if (results) results.hidden = !open;
    input?.setAttribute('aria-expanded', String(open));
  }

  function closeResults(): void {
    searchRequest++;
    setResultsOpen(false);
  }

  function highlight(text: string, q: string): string {
    if (!q) return escapeHtml(text);
    const lower = text.toLowerCase();
    const qLower = q.toLowerCase();
    let result = '';
    let i = 0;
    while (i < text.length) {
      const idx = lower.indexOf(qLower, i);
      if (idx === -1) {
        result += escapeHtml(text.slice(i));
        break;
      }
      result += escapeHtml(text.slice(i, idx));
      result += `<mark>${escapeHtml(text.slice(idx, idx + q.length))}</mark>`;
      i = idx + q.length;
    }
    return result;
  }

  function render(articles: Article[], q: string): void {
    if (!list || !empty || !count) return;
    const matches = searchArticles(articles, q);
    count.textContent = `找到 ${matches.length} 篇`;

    if (matches.length === 0) {
      list.innerHTML = '';
      empty.textContent = `没找到包含 "${q}" 的文章, 试试别的关键词`;
      empty.hidden = false;
      return;
    }

    empty.hidden = true;
    const top = matches.slice(0, MAX_RESULTS);
    list.innerHTML = top
      .map((r: SearchResult) => {
        const a = r.article;
        const snippetsHtml = r.snippetsHtml;
        const matchCount = r.matchCount;
        const moreCount = matchCount > snippetsHtml.length ? matchCount - snippetsHtml.length : 0;
        // snippetsHtml 已经 HTML escape + <mark> 高亮, 直接 join
        const snippetsBlock = snippetsHtml.length > 0
          ? `<div class="search-result-snippets">${snippetsHtml.map((s: string) => `<div class="snippet">${s}</div>`).join('')}${moreCount > 0 ? `<div class="snippet-more">还有 ${moreCount} 处匹配</div>` : ''}</div>`
          : (r.matchedTitle && !r.matchedBody
              ? `<div class="search-result-snippet-title-only">仅标题匹配</div>`
              : '');
        return `<li role="option"><a href="/docs/${escapeHtml(a.slug)}/" class="search-result-link"><div class="search-result-title">${highlight(a.title || '', q)}</div>${snippetsBlock}<div class="search-result-date">${escapeHtml(a.date || '')}</div></a></li>`;
      })
      .join('');
  }

  async function doSearch(): Promise<void> {
    if (!input) return;
    const request = ++searchRequest;
    const query = input.value.trim().slice(0, MAX_QUERY_LENGTH);
    setResultsOpen(true);

    if (!query) {
      showMessage('请输入关键词, 然后点击搜索');
      return;
    }

    showMessage('正在加载搜索索引…');
    try {
      const articles = await loadSearchIndex();
      if (request === searchRequest) render(articles, query);
    } catch {
      if (request === searchRequest) showMessage('搜索索引加载失败，请重新搜索');
    }
  }

  // 搜索按钮触发
  btn?.addEventListener('click', () => doSearch());

  // Enter 键触发
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      if (e.isComposing || e.keyCode === 229) return;
      e.preventDefault();
      doSearch();
    } else if (e.key === 'Escape') {
      closeResults();
      input.blur();
    }
  });

  // Click outside closes
  document.addEventListener('click', (e) => {
    if (box && !box.contains(e.target as Node)) closeResults();
  });
</script>

<style>
  .search-box-wrap {
    position: relative;
    width: 100%;
    margin: 0 0 var(--space-6, 1.5rem);
  }
  .search-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    background: var(--color-bg-card, #150a0a);
    border: 1px solid var(--color-border, #2a1515);
    border-radius: var(--radius-md, 0.5rem);
    transition: border-color var(--transition-fast, 0.15s ease);
  }
  .search-input-row:focus-within {
    border-color: var(--color-accent, #e60000);
    box-shadow: 0 0 0 3px rgba(230, 0, 0, 0.15);
  }
  .search-icon {
    color: var(--color-text-muted, #8a8a8a);
    flex-shrink: 0;
  }
  .search-input-row:focus-within .search-icon {
    color: var(--color-accent, #e60000);
  }
  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--color-text-primary, #f5f0f0);
    font-size: var(--font-size-base, 1rem);
    outline: none;
    padding: 0;
    font-family: inherit;
  }
  .search-input::placeholder {
    color: var(--color-text-muted, #6b6b6b);
  }
  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
    height: 16px;
    width: 16px;
    background: var(--color-text-muted, #8a8a8a);
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M18 6L6 18M6 6l12 12' stroke='black' stroke-width='2'/></svg>") center / contain no-repeat;
            mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M18 6L6 18M6 6l12 12' stroke='black' stroke-width='2'/></svg>") center / contain no-repeat;
    cursor: pointer;
  }
  .search-hint {
    display: block;
    text-align: right;
    font-size: 0.7rem;
    color: var(--color-text-muted, #6b6b6b);
    margin-top: 0.25rem;
    padding-right: 0.5rem;
  }
  .search-results {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: var(--space-2, 0.5rem);
    background: var(--color-bg-card, #150a0a);
    border: 1px solid var(--color-border, #2a1515);
    border-radius: var(--radius-md, 0.5rem);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    max-height: 480px;
    overflow-y: auto;
    z-index: 10;
  }
  .search-count {
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, #8a8a8a);
    border-bottom: 1px solid var(--color-border, #2a1515);
  }
  .search-empty {
    padding: var(--space-6, 1.5rem) var(--space-4, 1rem);
    text-align: center;
    color: var(--color-text-muted, #8a8a8a);
    font-size: var(--font-size-sm, 0.875rem);
  }
  .search-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .search-list :global(li) {
    border-bottom: 1px solid var(--color-border, #2a1515);
  }
  .search-list :global(li:last-child) {
    border-bottom: none;
  }
  .search-list :global(.search-result-link) {
    display: block;
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    color: var(--color-text-primary, #f5f0f0);
    text-decoration: none;
    transition: background var(--transition-fast, 0.15s ease);
  }
  .search-list :global(.search-result-link:hover),
  .search-list :global(.search-result-link:focus) {
    background: var(--color-bg-hover, #2a1515);
  }
  .search-list :global(.search-result-title) {
    font-size: var(--font-size-base, 1rem);
    margin-bottom: var(--space-1, 0.25rem);
  }
  .search-list :global(.search-result-title :global(mark)) {
    background: rgba(230, 0, 0, 0.25);
    color: var(--color-accent, #e60000);
    padding: 0 2px;
    border-radius: 2px;
  }
  .search-list :global(.search-result-snippets) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 2px;
  }
  .search-list :global(.search-result-snippets .snippet) {
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-secondary, #c8c0c0);
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .search-list :global(.search-result-snippets .snippet :global(mark)) {
    background: rgba(230, 0, 0, 0.25);
    color: var(--color-accent, #e60000);
    padding: 0 2px;
    border-radius: 2px;
  }
  .search-list :global(.search-result-snippets .snippet-more) {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted, #8a8a8a);
    margin-top: 2px;
    font-style: italic;
  }
  .search-list :global(.search-result-snippet-title-only) {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted, #8a8a8a);
    margin-top: 2px;
    font-style: italic;
  }
  .search-list :global(.search-result-date) {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted, #8a8a8a);
  }
</style>
