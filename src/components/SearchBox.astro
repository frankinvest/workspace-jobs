---
/**
 * SearchBox.astro — frankofswing.com 文章搜索框
 *
 * Props:
 *   articles: Article[]  — 搜索索引 (slug + title + date + body excerpt)
 *
 * 行为:
 *   - input 触发, debounce 200ms
 *   - 不区分大小写 substring 匹配 (title + body)
 *   - 边界: query < 2 字不搜, query > 50 字截断
 *   - 结果 < 10  显示
 *   - a11y: role=combobox, aria-expanded, Esc 关闭
 */
import type { Article } from '../utils/search';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
const articlesJson = JSON.stringify(articles);
---

<div class="search-box-wrap" data-search-box>
  <div class="search-input-row">
    <svg
      class="search-icon"
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="search"
      class="search-input"
      placeholder={`输入关键词, 按 Enter 或点击搜索 (${articles.length} 篇财经早餐)`}
      aria-label="搜索文章"
      aria-describedby="search-hint"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results-list"
      autocomplete="off"
      data-search-input
    />
    <button
      type="button"
      class="search-btn"
      data-search-btn
      aria-label="执行搜索"
    >
      搜索
    </button>
  </div>
  <span id="search-hint" class="search-hint" aria-hidden="true">按 Enter 搜索 · Esc 关闭</span>

  <div
    class="search-results"
    role="listbox"
    id="search-results-list"
    aria-label="搜索结果"
    data-search-results
    hidden
  >
    <div class="search-count" data-search-count aria-live="polite"></div>
    <div class="search-empty" data-search-empty hidden>
      没找到匹配的文章, 试试别的关键词
    </div>
    <ul class="search-list" data-search-list></ul>
  </div>
</div>

<script type="application/json" data-search-data set:html={articlesJson}></script>

<script>
  // Client-side search filter (button-trigger, not live)
  const dataEl = document.querySelector('[data-search-data]');
  const articles: Article[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  const box = document.querySelector('[data-search-box]') as HTMLElement | null;
  const input = document.querySelector('[data-search-input]') as HTMLInputElement | null;
  const btn = document.querySelector('[data-search-btn]') as HTMLButtonElement | null;
  const results = document.querySelector('[data-search-results]') as HTMLElement | null;
  const list = document.querySelector('[data-search-list]') as HTMLUListElement | null;
  const empty = document.querySelector('[data-search-empty]') as HTMLElement | null;
  const count = document.querySelector('[data-search-count]') as HTMLElement | null;

  const MAX_LEN = 50;
  const MAX_RESULTS = 20;

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function highlight(text: string, q: string): string {
    if (!q) return escapeHtml(text);
    const lower = text.toLowerCase();
    const qLower = q.toLowerCase();
    let result = '';
    let i = 0;
    while (i < text.length) {
      const idx = lower.indexOf(qLower, i);
      if (idx === -1) {
        result += escapeHtml(text.slice(i));
        break;
      }
      result += escapeHtml(text.slice(i, idx));
      result += `<mark>${escapeHtml(text.slice(idx, idx + q.length))}</mark>`;
      i = idx + q.length;
    }
    return result;
  }

  function render(query: string): void {
    if (!input || !results || !list || !empty || !count) return;
    const q = query.trim().slice(0, MAX_LEN);

    if (q.length === 0) {
      empty.textContent = '请输入关键词, 然后点击搜索';
      empty.removeAttribute('hidden');
      count.textContent = '';
      list.innerHTML = '';
      results.removeAttribute('hidden');
      input.setAttribute('aria-expanded', 'true');
      return;
    }

    const qLower = q.toLowerCase();
    const matches = articles.filter((a) => {
      const titleLower = (a.title || '').toLowerCase();
      const bodyLower = (a.body || '').toLowerCase();
      return titleLower.includes(qLower) || bodyLower.includes(qLower);
    });

    count.textContent = `找到 ${matches.length} 篇`;

    if (matches.length === 0) {
      list.innerHTML = '';
      empty.textContent = `没找到包含 "${q}" 的文章, 试试别的关键词`;
      empty.removeAttribute('hidden');
      results.removeAttribute('hidden');
      input.setAttribute('aria-expanded', 'true');
      return;
    }

    empty.setAttribute('hidden', '');
    const top = matches.slice(0, MAX_RESULTS);
    list.innerHTML = top
      .map(
        (a) =>
          `<li role="option"><a href="/docs/${escapeHtml(a.slug)}/" class="search-result-link"><div class="search-result-title">${highlight(a.title || '', q)}</div><div class="search-result-snippet">${highlight((a.body || '').slice(0, 100), q)}${((a.body || '').length > 100 ? '...' : '')}</div><div class="search-result-date">${escapeHtml(a.date || '')}</div></a></li>`
      )
      .join('');
    results.removeAttribute('hidden');
    input.setAttribute('aria-expanded', 'true');
  }

  function doSearch(): void {
    if (!input) return;
    render(input.value);
  }

  // 搜索按钮触发
  btn?.addEventListener('click', () => doSearch());

  // Enter 键触发
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      doSearch();
    } else if (e.key === 'Escape') {
      results?.setAttribute('hidden', '');
      input.setAttribute('aria-expanded', 'false');
      input.blur();
    }
  });

  // Click outside closes
  document.addEventListener('click', (e) => {
    if (!box || !results) return;
    if (!box.contains(e.target as Node)) {
      results.setAttribute('hidden', '');
      input?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .search-box-wrap {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin: 0 auto var(--space-6, 1.5rem);
  }
  .search-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    background: var(--color-bg-card, #150a0a);
    border: 1px solid var(--color-border, #2a1515);
    border-radius: var(--radius-md, 0.5rem);
    transition: border-color var(--transition-fast, 0.15s ease);
  }
  .search-input-row:focus-within {
    border-color: var(--color-accent, #e60000);
    box-shadow: 0 0 0 3px rgba(230, 0, 0, 0.15);
  }
  .search-icon {
    color: var(--color-text-muted, #8a8a8a);
    flex-shrink: 0;
  }
  .search-input-row:focus-within .search-icon {
    color: var(--color-accent, #e60000);
  }
  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--color-text-primary, #f5f0f0);
    font-size: var(--font-size-base, 1rem);
    outline: none;
    padding: 0;
    font-family: inherit;
  }
  .search-input::placeholder {
    color: var(--color-text-muted, #6b6b6b);
  }
  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
    height: 16px;
    width: 16px;
    background: var(--color-text-muted, #8a8a8a);
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M18 6L6 18M6 6l12 12' stroke='black' stroke-width='2'/></svg>") center / contain no-repeat;
            mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M18 6L6 18M6 6l12 12' stroke='black' stroke-width='2'/></svg>") center / contain no-repeat;
    cursor: pointer;
  }
  .search-hint {
    display: block;
    text-align: right;
    font-size: 0.7rem;
    color: var(--color-text-muted, #6b6b6b);
    margin-top: 0.25rem;
    padding-right: 0.5rem;
  }
  .search-results {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: var(--space-2, 0.5rem);
    background: var(--color-bg-card, #150a0a);
    border: 1px solid var(--color-border, #2a1515);
    border-radius: var(--radius-md, 0.5rem);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    max-height: 480px;
    overflow-y: auto;
    z-index: 10;
  }
  .search-count {
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, #8a8a8a);
    border-bottom: 1px solid var(--color-border, #2a1515);
  }
  .search-empty {
    padding: var(--space-6, 1.5rem) var(--space-4, 1rem);
    text-align: center;
    color: var(--color-text-muted, #8a8a8a);
    font-size: var(--font-size-sm, 0.875rem);
  }
  .search-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .search-list :global(li) {
    border-bottom: 1px solid var(--color-border, #2a1515);
  }
  .search-list :global(li:last-child) {
    border-bottom: none;
  }
  .search-list :global(.search-result-link) {
    display: block;
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    color: var(--color-text-primary, #f5f0f0);
    text-decoration: none;
    transition: background var(--transition-fast, 0.15s ease);
  }
  .search-list :global(.search-result-link:hover),
  .search-list :global(.search-result-link:focus) {
    background: var(--color-bg-hover, #2a1515);
  }
  .search-list :global(.search-result-title) {
    font-size: var(--font-size-base, 1rem);
    margin-bottom: var(--space-1, 0.25rem);
  }
  .search-list :global(.search-result-title :global(mark)) {
    background: rgba(230, 0, 0, 0.25);
    color: var(--color-accent, #e60000);
    padding: 0 2px;
    border-radius: 2px;
  }
  .search-list :global(.search-result-date) {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-muted, #8a8a8a);
  }
</style>